# The build driver forces this value for its Astro subprocess.
ASTRO_TELEMETRY_DISABLED=1
# Optional existing Ego task space, used by both CSP and offline acceptance.
# READING_NOTES_CSP_SPACE=26
# Test subprocess only, with publish --dry-run; never enable in normal builds.
# READING_NOTES_TEST_CRASH=journal
# I035 content health probe uses fixed loopback HTTPS; no extra environment variable.

#lang racket
(require (except-in rackunit check) rackunit/text-ui json "chapter07.rkt" "chapter07_examples.rkt")
(define assertions 0)
(define (equals actual expected) (set! assertions (add1 assertions)) (check-equal? actual expected))
(define (typing-fails thunk [kind #f])
  (set! assertions (add1 assertions))
  (check-exn (lambda (e) (and (exn:fail:typing? e) (or (not kind) (eq? kind (exn:fail:typing-kind e))))) thunk))
(define (runtime-fails thunk kind)
  (set! assertions (add1 assertions))
  (check-exn (lambda (e) (and (exn:fail:object? e) (eq? kind (exn:fail:object-kind e)))) thunk))
(define types-7-12
  '((int -> int) ((a0 -> int) -> (a0 -> int)) (a0 -> a0)
    ((a0 -> a1) -> (a0 -> a1)) ((int -> a0) -> a0) occurs
    (bool -> int) (bool -> (int -> int)) mismatch mismatch
    ((a0 -> int) -> ((int -> int) -> ((int -> bool) -> (a0 -> int))))
    (int -> ((int -> bool) -> (((int -> bool) -> int) -> int))) occurs))
(define engines '(eager lazy memo walk global vector))
(define tests
  (test-suite "chapter7"
    (test-case "source examples and independent type answers"
      (for ([e exercise-7-1] [expected types-7-12])
        (for* ([engine engines] [two-phase? '(#f #t)])
          (if (memq expected '(occurs mismatch))
              (typing-fails (lambda () (infer e #:engine engine #:two-phase? two-phase?)) expected)
              (equals (infer e #:engine engine #:two-phase? two-phase?) expected))))
      (for ([n (in-range 15)])
        (define f "proc(r) proc(n) if zero?(n) then 0 else -((r -(n,1)),-2)")
        ;; The guarded fixed-point value is semantically useful, but not simply typable.
        (equals (evaluate (format "((~a ~a) ~a)" (last exercise-7-1) f n)) (* 2 n))))
    (test-case "direct checking and error order"
      (define double "letrec int double(x:int)=if zero?(x) then 0 else -((double -(x,1)),-2) in (double 3)")
      (equals (check double) 'int) (equals (evaluate double) 6)
      (define lexical "let x=zero?(0) in let f=proc(y:int) if x then y else 0 in let x=3 in (f 4)")
      (equals (check lexical) 'int) (equals (evaluate lexical) 4)
      (equals (check "proc (f : (bool -> int)) proc(n : int) (f zero?(n))") '((bool -> int) -> (int -> int)))
      (equals (check "letrec int double(x : int) = if zero?(x) then 0 else -((double -(x,1)),-2) in double") '(int -> int))
      (typing-fails (lambda () (check "letrec bool f(x : int) = x in (f 0)")))
      (typing-fails (lambda () (check "if 1 then missing else 0" #:early-if? #t)) 'condition)
      (typing-fails (lambda () (check "if 1 then missing else 0" #:early-if? #f)) 'unbound)
      (typing-fails (lambda () (check "proc(x) x")) 'annotation)
      (typing-fails (lambda () (infer "proc(x) x" #:omitted? #f)) 'annotation)
      (equals (infer "proc(x) x") (infer "proc(x : ?) x" #:omitted? #f))
      (typing-fails (lambda () (infer "proc(x,x) x")) 'duplicate)
      (typing-fails (lambda () (infer "1 @")))
      (typing-fails (lambda () (infer "1 2"))))
    (test-case "parallel bindings, recursion, and arity"
      (equals (infer mutual) 'int) (equals (evaluate mutual) 1)
      (equals (infer higher-order-rec) 'int) (equals (evaluate higher-order-rec) 1)
      (typing-fails (lambda () (infer (string-replace higher-order-rec "odd(x : ?)" "odd(x : bool)"))))
      (equals (infer "let x = zero?(0) y = -(x,1) in y") 'int)
      (equals (evaluate "let x = zero?(0) y = -(x,1) in y") 9)
      (for ([mode engines])
        (equals (infer "letrec ? f(x:?,y:?) = if zero?(x) then y else (f -(x,1) y) in (f 5 44)" #:engine mode) 'int))
      (equals (check "(proc(x:int,y:bool) if y then x else 0 4 zero?(0))") 'int)
      (equals (evaluate "(proc(x:int,y:bool) if y then x else 0 4 zero?(0))") 4)
      (equals (infer "(proc() 3)") 'int) (equals (evaluate "(proc() 3)") 3)
      (typing-fails (lambda () (infer "(proc(x) x 1 2)")))
      (typing-fails (lambda () (infer "let x=1 x=2 in x")) 'duplicate)
      (typing-fails (lambda () (infer "letrec ? f(x:?)=x ? f(y:?)=y in f")) 'duplicate))
    (test-case "pairs, lists, state, and dynamic boundaries"
      (for ([program '("unpair a b = newpair(3,zero?(0)) in if b then a else 0"
                        "let r = newref(11) in begin setref(r,22); -(deref(r),1) end"
                        "let x=0 in begin set x=4; x end")]
            [value '(3 21 4)])
        (equals (infer program) 'int) (equals (evaluate program) value))
      (equals (check "unpair a b=newpair(3,zero?(0)) in a") 'int)
      (equals (check "cons(1,emptylist_int)") '(listof int))
      (equals (infer "emptylist") '(listof a0))
      (equals (infer "proc(x) cons(x,emptylist)") '(a0 -> (listof a0)))
      (equals (check "car(emptylist_int)") 'int)
      (runtime-fails (lambda () (evaluate "car(emptylist_int)")) 'empty-list)
      (typing-fails (lambda () (infer "list(1,zero?(0))")))
      (typing-fails (lambda () (infer "setref(newref(1),zero?(0))")))
      (typing-fails (lambda () (infer "-(setref(newref(1),2),1)")))
      (equals (check "setref(newref(1),2)") 'void)
      (equals (check "set x=4") 'int) (equals (evaluate "set x=4") 27)
      (define mut "let p=newpair(1,zero?(0)) in let q=p in begin setleft(q,8); left(p) end")
      (equals (check mut #:mutable-pairs? #t) 'int)
      (equals (infer mut #:mutable-pairs? #t) 'int)
      (equals (evaluate mut #:mutable-pairs? #t) 8)
      (typing-fails (lambda () (infer "setleft(newpair(1,2),zero?(0))" #:mutable-pairs? #t)))
      (typing-fails (lambda () (infer mut)) 'feature)
      (runtime-fails (lambda () (evaluate "if 3 then 1 else 2")) 'runtime-type)
      (equals (infer "letrec ? loop(x:?)=(loop x) in (loop 1)") 'a0)
      (for ([fuel (list -1 1/2 #f 0 2.0)])
        (runtime-fails (lambda () (evaluate "1" #:fuel fuel)) 'fuel))
      (equals (evaluate "1" #:fuel 1) 1)
      (runtime-fails (lambda () (evaluate "letrec ? loop(x:?)=(loop x) in (loop 1)" #:fuel 1000)) 'fuel))
    (test-case "substitution composition and memoization"
      (define a (tv 0)) (define b (tv 1)) (define c (tv 2))
      (define s (extend-eager '() a (proc-t (list b) c)))
      (define s2 (extend-eager s b 'int))
      (equals (apply-eager a s2) (proc-t '(int) c))
      (equals (apply-eager (proc-t (list a) b) s2)
              (apply-one (apply-eager (proc-t (list a) b) s) b 'int))
      (equals (no-bound-variable-on-rhs? s2) #t)
      (define lazy (list (cons b 'int) (cons a b)))
      (equals (no-bound-variable-on-rhs? lazy) #f)
      (equals (apply-lazy a lazy) 'int)
      (define visits (make-hash))
      (equals (apply-lazy (proc-t (list a a b) a) lazy #:memo? #t
                             #:visits (lambda (v) (hash-update! visits v add1 0)))
              (proc-t '(int int int) 'int))
      (equals (andmap (lambda (n) (= n 1)) (hash-values visits)) #t)
      (typing-fails (lambda () (apply-lazy a (list (cons a b) (cons b a)))) 'occurs)
      (equals (type-alpha=? (proc-t (list a) a) (proc-t (list c) c)) #t)
      (equals (type-alpha=? (proc-t (list a) a) (proc-t (list a) b)) #f)
      (for ([mode engines])
        (define u (make-solver mode))
        ((solver-unify u) a b)
        (typing-fails (lambda () ((solver-unify u) b (proc-t (list a) 'int))) 'occurs)
        ((solver-unify u) b 'int)
        (equals ((solver-resolve u) a) 'int)
        (typing-fails (lambda () ((solver-unify u) (proc-t (list c) c) (proc-t '(int) 'bool))))))
    (test-case "polymorphic let, W, effects, and lexical capture"
      (typing-fails (lambda () (infer poly-id)))
      (for ([poly '(copy w)])
        (equals (infer poly-id #:polymorphism poly) 'int)
        (equals (run poly-id #:polymorphism poly) 11)
        (equals (infer polymorphic-map #:polymorphism poly) '(pairof (listof int) (listof bool)))
        (equals (datum (run polymorphic-map #:polymorphism poly)) '(pair (2 4) (#f #f))))
      (equals (hash-ref (inference-statistics (infer-details poly-id #:polymorphism 'w)) 'rhs-analyses) 1)
      (equals (hash-ref (inference-statistics (infer-details poly-id #:polymorphism 'copy)) 'rhs-analyses) 4)
      (for ([poly '(copy w)])
        (typing-fails (lambda () (infer "let unused=-(zero?(0),1) in 4" #:polymorphism poly)))
        (typing-fails (lambda () (infer "proc(x) let f=proc(y) x in if (f 0) then -(x,1) else 2" #:polymorphism poly)))
        (equals (infer "let x=4 in let f=proc(y) x in let x=zero?(0) in (f 0)" #:polymorphism poly) 'int)
        (equals (infer unsafe-reference #:polymorphism poly #:value-restriction? #f) 'bool)
        (typing-fails (lambda () (infer unsafe-reference #:polymorphism poly #:value-restriction? #t))))
      (runtime-fails (lambda () (evaluate unsafe-reference)) 'runtime-type)
      (typing-fails (lambda () (infer "let id=proc(x)x in begin set id=proc(x)zero?(x); (id zero?(0)) end" #:polymorphism 'w)) 'poly-assignment))
    (test-case "deterministic numerical oracles and principal solutions"
      (for* ([a (in-range -5 6)] [b (in-range -3 4)])
        (define p (format "let f=proc(x) -(x,~a) in (f ~a)" b a))
        (equals (infer p) 'int) (equals (infer p #:two-phase? #t) 'int)
        (equals (evaluate p) (- a b)))
      (define atoms (list 'int 'bool (tv 0) (tv 1)))
      (define shapes (append atoms (for*/list ([a atoms] [b atoms]) (proc-t (list a) b))))
      ;; Verify each successful most-general solution satisfies the original equation.
      ;; Each rejection is also checked against all six depth-one ground assignments.
      (define ground (list 'int 'bool (proc-t '(int) 'int) (proc-t '(int) 'bool) (proc-t '(bool) 'int) (proc-t '(bool) 'bool)))
      (for* ([a shapes] [b shapes])
        (define u (make-solver 'eager))
        (with-handlers ([exn:fail:typing?
                         (lambda (_)
                           (for* ([x ground] [y ground])
                             (define (grounded t) (apply-one (apply-one t (tv 0) x) (tv 1) y))
                             (set! assertions (add1 assertions)) (check-not-equal? (grounded a) (grounded b))))])
          ((solver-unify u) a b)
          (equals ((solver-resolve u) a) ((solver-resolve u) b)))))))
(define failures (run-tests tests))
(write-json (hash 'status (if (zero? failures) "passed" "failed") 'groups 7 'assertions assertions 'failures failures)) (newline)
(exit (if (zero? failures) 0 1))

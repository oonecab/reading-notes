#lang racket
;; Explicit locations, class descriptors and method application for CLASSES.
(require racket/match "chapter09_syntax.rkt")
(provide (all-defined-out))
(struct frame (names cells) #:transparent)
(struct closure (params body env classes context) #:transparent)
(struct context (self host) #:transparent)
(struct rfield (id name owner type init visibility) #:transparent)
(struct rstatic (name owner type cell visibility) #:transparent)
(struct rmethod (decl host body) #:mutable #:transparent)
(struct rclass (name parents fields view own-fields methods table slots statics classes) #:mutable #:transparent)
(struct object (class classes fields) #:transparent)
(struct prototype (view cells methods) #:transparent)
(struct proto-method (decl view env classes) #:transparent)
(struct bound (receiver method) #:transparent)
(struct execution (value output statistics events classes) #:transparent)
(define uninitialized (gensym 'uninitialized))
(define current-options (make-parameter (hash)))
(define current-fuel (make-parameter #f))
(define current-output (make-parameter #f))
(define current-events (make-parameter #f))
(define current-counts (make-parameter #f))
(define current-prepare (make-parameter (lambda (body names classes host) body)))
(define (option key [fallback #f]) (hash-ref (current-options) key fallback))
(define (count! key [n 1]) (when (current-counts) (hash-update! (current-counts) key (lambda (x) (+ x n)) 0)))
(define (event! x)
  (when (current-events)
    (set-box! (current-events) (cons x (unbox (current-events))))))
(define (tick!)
  (when (current-fuel)
    (when (zero? (unbox (current-fuel)))
      (oo-error 'fuel #f "evaluation budget exhausted"))
    (set-box! (current-fuel) (sub1 (unbox (current-fuel))))))
(define (make-frame names values) (frame (if (option 'lexical?) '() names) (list->vector (map box values))))
(define (lookup-cell env name)
  (count! 'symbol-lookups)
  (let loop ([fs env])
    (cond [(null? fs) (oo-error 'unbound name "unbound variable ~a" name)]
          [else (define at (index-of (frame-names (car fs)) name))
                (if at (vector-ref (frame-cells (car fs)) at) (loop (cdr fs)))])))
(define (read-cell cell where)
  (define value (unbox cell)) (when (eq? value uninitialized) (oo-error 'uninitialized where "read of uninitialized field ~a" where)) value)
(define (initial-env) (list (make-frame '(i v x) '(1 5 10))))
(define (initial-names) '((i v x)))
(define (lookup-class classes name)
  (hash-ref (if (box? classes) (unbox classes) classes) name (lambda () (oo-error 'class name "unknown class ~a" name))))
(define (object-class* obj)
  (unless (object? obj) (oo-error 'object obj "expected class object"))
  (if (rclass? (object-class obj)) (object-class obj) (lookup-class (object-classes obj) (object-class obj))))
(define (is-a? child ancestor)
  (or (eq? child ancestor) (for/or ([p (rclass-parents child)]) (is-a? p ancestor))))
(define (parent-of host)
  (unless (and (rclass? host) (pair? (rclass-parents host))) (oo-error 'super host "super has no lexical host parent"))
  (car (rclass-parents host)))
(define (accessible? visibility owner host)
  (or (eq? visibility 'public)
      (and (rclass? host) (if (eq? visibility 'private) (eq? owner host) (is-a? host owner)))))
(define (require-access! visibility owner ctx where)
  (unless (accessible? visibility owner (and ctx (context-host ctx))) (oo-error 'access where "inaccessible member ~a" where)))
(define (method-key name arity) (if (option 'overload?) (cons name arity) name))
(define (rmethod-key m) (method-key (mdecl-name (rmethod-decl m)) (length (mdecl-params (rmethod-decl m)))))
(define (merge-stable parent own)
  (define answer parent)
  (for ([m own])
    (define k (rmethod-key m)) (define pos (index-where answer (lambda (x) (equal? (rmethod-key x) k))))
    (set! answer (if pos (list-set answer pos m) (append answer (list m))))) answer)
(define (find-method class name arity)
  (define k (method-key name arity))
  (case (option 'method-lookup 'linear)
    [(hash) (count! 'method-probes)
            (hash-ref (rclass-table class) k (lambda () (oo-error 'method name "missing method ~a in ~a" name (rclass-name class))))]
    [else (let loop ([ms (rclass-methods class)])
            (cond [(null? ms) (oo-error 'method name "missing method ~a in ~a" name (rclass-name class))]
                  [else (count! 'method-probes) (if (equal? (rmethod-key (car ms)) k) (car ms) (loop (cdr ms)))]))]))
(define (field-bindings host)
  (filter (lambda (p) (define f (cdr p))
            (and (or (not (option 'host-fields-only?)) (eq? (rfield-owner f) host))
                 (accessible? (rfield-visibility f) (rfield-owner f) host))) (rclass-view host)))
(define (static-bindings host)
  (filter (lambda (s) (accessible? (rstatic-visibility s) (rstatic-owner s) host)) (rclass-statics host)))
(define (object-field-frame obj bindings)
  (frame (if (option 'lexical?) '() (map car bindings)) (list->vector (for/list ([p bindings]) (hash-ref (object-fields obj) (rfield-id (cdr p)))))))
(define (static-frame bindings) (frame (if (option 'lexical?) '() (map rstatic-name bindings)) (list->vector (map rstatic-cell bindings))))
(define (invoke-method method receiver values caller)
  (define d (rmethod-decl method)) (define host (rmethod-host method))
  (require-access! (mdecl-visibility d) host caller (mdecl-name d))
  (unless (= (length values) (length (mdecl-params d))) (oo-error 'arity (mdecl-name d) "method argument count mismatch"))
  (unless (is-a? (object-class* receiver) host) (oo-error 'receiver (mdecl-name d) "receiver is not an instance of method host"))
  (count! 'method-calls)
  (event! (list 'invoke (rclass-name (object-class* receiver)) (rclass-name host) (mdecl-name d)))
  (define env (list (make-frame (map car (mdecl-params d)) values)
                    (object-field-frame receiver (field-bindings host))
                    (static-frame (static-bindings host))))
  (evaluate (rmethod-body method) env (rclass-classes host) (context receiver host)))
(define (make-class declaration classes [outer-env '()])
  (match-define (cdecl name parent-names interfaces fdecls sdecls mdecls) declaration)
  (when (and (> (length parent-names) 1) (not (option 'multiple?))) (oo-error 'inheritance name "multiple inheritance requires multiple? mode"))
  (unique! parent-names 'parents) (unique! (append (map fdecl-name fdecls) (map fdecl-name sdecls)) 'fields)
  (define parents (map (lambda (n) (lookup-class classes n)) parent-names))
  (define host (rclass name parents '() '() '() '() (hash) #() '() classes))
  (define own (for/list ([f fdecls]) (rfield (gensym (fdecl-name f)) (fdecl-name f) host (fdecl-type f) (fdecl-init f) (fdecl-visibility f))))
  (define inherited (remove-duplicates (append-map rclass-fields parents) eq?))
  (define own-names (map rfield-name own))
  ;; Different inherited declarations of the same field require qualification.
  (define inherited-view (remove-duplicates (append-map rclass-view parents) (lambda (a b) (eq? (cdr a) (cdr b)))))
  (define conflicts (for/list ([n (remove-duplicates (map car inherited-view))]
                              #:when (> (count (lambda (p) (eq? (car p) n)) inherited-view) 1)) n))
  (define view (append (for/list ([p inherited-view])
                         (cons (if (or (memq (car p) own-names) (memq (car p) conflicts)) (gensym (car p)) (car p)) (cdr p)))
                       (map (lambda (f) (cons (rfield-name f) f)) own)))
  (set-rclass-fields! host (append inherited own)) (set-rclass-own-fields! host own) (set-rclass-view! host view)
  (define own-methods (for/list ([m mdecls]) (rmethod m host (mdecl-body m))))
  (unique! (map rmethod-key own-methods) 'methods)
  (define parent-methods (remove-duplicates (append-map (lambda (p) (vector->list (rclass-slots p))) parents) eq?))
  (for ([m own-methods])
    (for ([p parent-methods] #:when (equal? (rmethod-key p) (rmethod-key m)))
      (when (mdecl-final? (rmethod-decl p)) (oo-error 'final (rmethod-key m) "cannot override final method"))))
  (for ([k (remove-duplicates (map rmethod-key parent-methods))])
    (when (and (> (count (lambda (m) (equal? (rmethod-key m) k)) parent-methods) 1)
               (not (member k (map rmethod-key own-methods))))
      (oo-error 'ambiguity k "conflicting inherited methods need an explicit child override")))
  (define stable (merge-stable parent-methods own-methods))
  (set-rclass-slots! host (list->vector stable))
  (set-rclass-methods! host (if (option 'stable?) stable (append own-methods (append-map rclass-methods parents))))
  (set-rclass-table! host (for/hash ([m stable]) (values (rmethod-key m) m)))
  (define parent-statics (remove-duplicates (append-map rclass-statics parents) eq?))
  (define own-statics (for/list ([s sdecls]) (rstatic (fdecl-name s) host (fdecl-type s) (box uninitialized) (fdecl-visibility s))))
  (set-rclass-statics! host (append own-statics (filter (lambda (s) (not (memq (rstatic-name s) (map rstatic-name own-statics)))) parent-statics)))
  ;; A static initializer sees earlier initialized statics and the local definition scope.
  (define earlier parent-statics)
  (for ([s own-statics] [d sdecls])
    (set-box! (rstatic-cell s) (evaluate (fdecl-init d) (cons (static-frame earlier) outer-env) classes #f))
    (set! earlier (cons s earlier)))
  host)
(define (prepare-class-methods! host)
  (for ([m (in-vector (rclass-slots host))] #:when (eq? (rmethod-host m) host))
    (define names (list (map car (mdecl-params (rmethod-decl m)))
                        (map car (field-bindings host))
                        (map rstatic-name (static-bindings host))))
    (set-rmethod-body! m ((current-prepare) (rmethod-body m) names (rclass-classes host) host))))
(define (build-classes declarations)
  (define env (box (hash)))
  (define root (rclass 'object '() '() '() '() '() (hash) #() '() env))
  (set-box! env (hash 'object root))
  (for ([d declarations] #:when (cdecl? d))
    (when (hash-has-key? (unbox env) (cdecl-name d)) (oo-error 'duplicate (cdecl-name d) "duplicate class"))
    (define c (make-class d env)) (set-box! env (hash-set (unbox env) (cdecl-name d) c)))
  (for ([c (in-hash-values (unbox env))]) (prepare-class-methods! c)) env)
(define (new-instance class)
  (define fields (for/hash ([f (rclass-fields class)]) (values (rfield-id f) (box uninitialized))))
  (define object-value (object (if (eq? (option 'object-class 'name) 'record) class (rclass-name class)) (unbox (rclass-classes class)) fields))
  ;; Initializer expressions can only refer to earlier fields of their declaring class.
  (for ([f (rclass-fields class)] #:when (rfield-init f))
    (define host (rfield-owner f))
    (define before (takef (rclass-fields host) (lambda (x) (not (eq? x f)))))
    (define bindings (filter (lambda (p) (memq (cdr p) before)) (rclass-view host)))
    (set-box! (hash-ref fields (rfield-id f))
              (evaluate (rfield-init f) (list (object-field-frame object-value bindings) (static-frame (static-bindings host))) (rclass-classes host) #f)))
  (count! 'objects) object-value)
(define (visible-field class name)
  (define pair (assq name (rclass-view class)))
  (unless pair (oo-error 'field name "field ~a is hidden or ambiguous" name)) (cdr pair))
(define (integer-value v) (unless (exact-integer? v) (oo-error 'number v "expected integer")) v)
(define (boolean-value v) (unless (boolean? v) (oo-error 'boolean v "expected boolean")) v)
(define (list-value v) (unless (list? v) (oo-error 'list v "expected list")) v)
(define (string-value v) (unless (string? v) (oo-error 'string v "expected string")) v)
(define (assignment-result) (if (option 'typed?) 'void 27))
(define primitive-arities (hash '+ 2 '- 2 '* 2 'zero? 1 'equal? 2 'less? 2 'greater? 2 'cons 2 'car 1 'cdr 1 'null? 1 'print 1 'concat 2 'number-to-string 1))
(define (primitive name args)
  (define arity (hash-ref primitive-arities name #f))
  (unless (or (not arity) (= (length args) arity)) (oo-error 'arity name "primitive argument count mismatch"))
  (case name
    [(+) (apply + (map integer-value args))] [(-) (apply - (map integer-value args))] [(*) (apply * (map integer-value args))]
    [(zero?) (zero? (integer-value (car args)))] [(equal?) (apply = (map integer-value args))]
    [(less?) (apply < (map integer-value args))] [(greater?) (apply > (map integer-value args))]
    [(list) args] [(cons) (cons (car args) (list-value (cadr args)))]
    [(null?) (null? (list-value (car args)))]
    [(car cdr) (define xs (list-value (car args))) (when (null? xs) (oo-error 'empty name "empty list access")) ((if (eq? name 'car) car cdr) xs)]
    [(print) (define v (integer-value (car args))) (set-box! (current-output) (cons v (unbox (current-output)))) 1]
    [(concat) (apply string-append (map string-value args))] [(number-to-string) (number->string (integer-value (car args)))]
    [else (oo-error 'primitive name "unknown primitive")]))
(define (call-procedure procedure values [receiver #f])
  (cond [(closure? procedure)
         (unless (= (length values) (length (closure-params procedure))) (oo-error 'arity procedure "procedure argument count mismatch"))
         (define ctx (if receiver (context receiver #f) (closure-context procedure)))
         (evaluate (closure-body procedure) (cons (make-frame (map car (closure-params procedure)) values) (closure-env procedure)) (closure-classes procedure) ctx)]
        [(bound? procedure) (define method (bound-method procedure))
         (if (closure? method) (call-procedure method values (bound-receiver procedure))
             (let ([d (proto-method-decl method)] [p (bound-receiver procedure)])
               (unless (= (length values) (length (mdecl-params d))) (oo-error 'arity d "prototype method arity"))
               (evaluate (mdecl-body d)
                         (cons (make-frame (map car (mdecl-params d)) values)
                               (cons (frame (map car (proto-method-view method))
                                            (list->vector (map (lambda (x) (hash-ref (prototype-cells p) (cdr x))) (proto-method-view method))))
                                     (proto-method-env method)))
                         (proto-method-classes method) (context p #f))))]
        [else (oo-error 'procedure procedure "expected procedure")]))
(define (prototype-value v) (unless (prototype? v) (oo-error 'prototype v "expected prototype/closure object")) v)
(define (get-proto-method p name)
  (bound p (hash-ref (prototype-methods p) name (lambda () (oo-error 'method name "missing closure/prototype method")))))
(define (evaluate exp env classes ctx)
  (tick!)
  (match exp
    [(expr 'const (list v)) v] [(expr 'unit _) 'void] [(expr 'hole _) (oo-error 'hole exp "unfinished source skeleton cannot execute")]
    [(expr 'var (list name)) (read-cell (lookup-cell env name) name)]
    [(expr 'lexref (list depth index)) (count! 'lexical-reads) (read-cell (vector-ref (frame-cells (list-ref env depth)) index) (list depth index))]
    [(expr 'set (list name rhs)) (define v (evaluate rhs env classes ctx)) (set-box! (lookup-cell env name) v) (assignment-result)]
    [(expr 'lexset (list depth index rhs)) (define v (evaluate rhs env classes ctx)) (set-box! (vector-ref (frame-cells (list-ref env depth)) index) v) (assignment-result)]
    [(expr 'if (list c a b)) (evaluate (if (boolean-value (evaluate c env classes ctx)) a b) env classes ctx)]
    [(expr 'proc (list ps body)) (closure ps body env classes ctx)]
    [(expr 'let (list bindings body))
     (define vs (for/list ([p bindings]) (evaluate (cdr p) env classes ctx)))
     (evaluate body (cons (make-frame (map car bindings) vs) env) classes ctx)]
    [(expr 'rec (list declarations body))
     (define f (make-frame (map car declarations) (map (lambda (_) uninitialized) declarations))) (define next (cons f env))
     (for ([d declarations] [cell (in-vector (frame-cells f))]) (set-box! cell (closure (cadr d) (cadddr d) next classes ctx)))
     (evaluate body next classes ctx)]
    [(expr 'call (list rator operands))
     (define f (evaluate rator env classes ctx)) (define vs (for/list ([e operands]) (evaluate e env classes ctx))) (call-procedure f vs)]
    [(expr 'begin es) (for/fold ([v 'void]) ([e es]) (evaluate e env classes ctx))]
    [(expr 'prim (list name operands)) (primitive name (for/list ([e operands]) (evaluate e env classes ctx)))]
    [(expr 'emptylist _) '()]
    [(expr 'self _) (unless ctx (oo-error 'self exp "self outside method")) (context-self ctx)]
    [(expr 'new (list class-name operands))
     (define vs (for/list ([e operands]) (evaluate e env classes ctx)))
     (define class (lookup-class classes class-name)) (define obj (new-instance class))
     (invoke-method (find-method class 'initialize (length vs)) obj vs ctx) obj]
    [(expr 'send (list receiver name operands))
     ;; Faithful explicit convention for the source let: operands left-to-right, then receiver.
     (define vs (for/list ([e operands]) (evaluate e env classes ctx)))
     (define obj (evaluate receiver env classes ctx))
     (if (prototype? obj) (call-procedure (get-proto-method obj name) vs)
         (let ([class (if (and (option 'static-self?) (eq? (expr-tag receiver) 'self) ctx) (context-host ctx) (object-class* obj))])
           (invoke-method (find-method class name (length vs)) obj vs ctx)))]
    [(expr 'super (list name operands))
     (unless ctx (oo-error 'super exp "super outside method"))
     (define vs (for/list ([e operands]) (evaluate e env classes ctx)))
     (invoke-method (find-method (parent-of (context-host ctx)) name (length vs)) (context-self ctx) vs ctx)]
    [(expr 'direct-super (list method operands))
     (define vs (for/list ([e operands]) (evaluate e env classes ctx)))
     (invoke-method method (context-self ctx) vs ctx)]
    [(expr (or 'named-send 'static-send) (list class-name receiver name operands))
     (define vs (for/list ([e operands]) (evaluate e env classes ctx))) (define obj (evaluate receiver env classes ctx))
     (define class (lookup-class classes class-name))
     (unless (is-a? (object-class* obj) class) (oo-error 'receiver exp "named receiver is not a subtype"))
     (invoke-method (find-method class name (length vs)) obj vs ctx)]
    [(expr 'named-slot (list class index receiver operands))
     (define vs (for/list ([e operands]) (evaluate e env classes ctx))) (define obj (evaluate receiver env classes ctx))
     (unless (is-a? (object-class* obj) class) (oo-error 'receiver exp "named receiver is not a subtype"))
     (count! 'slot-reads) (invoke-method (vector-ref (rclass-slots class) index) obj vs ctx)]
    [(expr (and tag (or 'instanceof 'cast)) (list receiver class-name))
     (define obj (evaluate receiver env classes ctx)) (define yes? (is-a? (object-class* obj) (lookup-class classes class-name)))
     (if (eq? tag 'instanceof) yes? (if yes? obj (oo-error 'cast class-name "cast failed")))]
    [(expr 'field (list named super? receiver name rhs))
     (define obj (evaluate receiver env classes ctx))
     (define class (cond [named (lookup-class classes named)] [super? (unless ctx (oo-error 'super exp "super field outside method")) (parent-of (context-host ctx))] [else (object-class* obj)]))
     (unless (is-a? (object-class* obj) class) (oo-error 'receiver exp "named field receiver mismatch"))
     (define f (visible-field class name)) (require-access! (rfield-visibility f) (rfield-owner f) ctx name)
     (define cell (hash-ref (object-fields obj) (rfield-id f)))
     (if rhs (begin (set-box! cell (evaluate rhs env classes ctx)) (assignment-result)) (read-cell cell name))]
    [(expr 'local-class (list d body))
     (define next (box (if (box? classes) (unbox classes) classes)))
     (define c (make-class d next env)) (set-box! next (hash-set (unbox next) (cdecl-name d) c))
     (prepare-class-methods! c)
     (evaluate body env next ctx)]
    [(expr 'emptyobject _) (prototype '() (hash) (hash))]
    [(expr 'getmethod (list receiver name)) (get-proto-method (prototype-value (evaluate receiver env classes ctx)) name)]
    [(expr 'newobject (list parent bindings))
     (define p (if parent (prototype-value (evaluate parent env classes ctx)) (prototype '() (hash) (hash))))
     (define methods (for/fold ([ms (prototype-methods p)]) ([b bindings])
                       (define f (evaluate (cdr b) env classes ctx)) (unless (closure? f) (oo-error 'procedure b "newobject expects procedure methods"))
                       (hash-set ms (car b) f)))
     (prototype (prototype-view p) (prototype-cells p) methods)]
    [(expr 'clone (list receiver))
     (define p (prototype-value (evaluate receiver env classes ctx)))
     (prototype (prototype-view p) (for/hash ([(k v) (in-hash (prototype-cells p))]) (values k (box (unbox v)))) (prototype-methods p))]
    [(expr 'extend (list receiver fields methods))
     (define p (prototype-value (evaluate receiver env classes ctx)))
     (unique! (map fdecl-name fields) 'prototype-fields) (unique! (map mdecl-name methods) 'prototype-methods)
     (define own (map (lambda (f) (cons (fdecl-name f) (gensym (fdecl-name f)))) fields))
     (define view (append own (filter (lambda (p) (not (assq (car p) own))) (prototype-view p))))
     (define cells (for/fold ([cells (for/hash ([(k v) (in-hash (prototype-cells p))]) (values k (box (unbox v))))]) ([f fields] [entry own])
                     (unless (fdecl-init f) (oo-error 'initialization f "prototype field needs initializer"))
                     (hash-set cells (cdr entry) (box (evaluate (fdecl-init f) env classes ctx)))))
     (prototype view cells (for/fold ([ms (prototype-methods p)]) ([m methods])
                             (hash-set ms (mdecl-name m) (proto-method m view env classes))))]
    [_ (oo-error 'syntax exp "unsupported runtime expression")]))
(define (execute parsed options #:prepare [prepare (lambda (body names classes host) body)])
  (parameterize ([current-options options] [current-fuel (box (hash-ref options 'fuel 100000))]
                 [current-output (box '())] [current-events (box '())] [current-counts (make-hash)] [current-prepare prepare])
    (define classes (build-classes (pgm-decls parsed)))
    (define body (prepare (pgm-body parsed) (initial-names) classes #f))
    (define value (evaluate body (initial-env) classes #f))
    (execution value (reverse (unbox (current-output))) (hash-copy (current-counts)) (reverse (unbox (current-events))) classes)))

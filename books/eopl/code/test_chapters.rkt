#lang racket/base
(require rackunit rackunit/text-ui racket/list racket/port json
         (prefix-in c1: "chapter01.rkt") (prefix-in c2: "chapter02.rkt"))
(define assertions 0)
(define (same actual expected) (set! assertions (add1 assertions)) (check-equal? actual expected))
(define (fails thunk [pattern exn:fail?])
  (set! assertions (add1 assertions)) (check-exn pattern thunk))
(define small-lists
  (let grow ([n 4])
    (if (= n 0) '(())
        (cons '() (for*/list ([x '(-1 0 1)] [xs (grow (sub1 n))]) (cons x xs))))))
(define suites
  (test-suite "EOPL chapters 1 and 2"
    (test-case "chapter 1 basics and error context"
      (same (c1:list-length '(a (b c) d)) 3)
      (same (c1:nth-element '(a b c) 0) 'a)
      (same (c1:nth-element '(a b c) 2) 'c)
      (fails (lambda () (c1:nth-element '(a b c) 7)) #rx"\\(a b c\\) does not have 8 elements")
      (fails (lambda () (c1:nth-element '() 0)))
      (fails (lambda () (c1:nth-element '(a) -1)))
      (same (c1:remove-first 'a4 '(c1 a4 c1 a4)) '(c1 c1 a4))
      (same (c1:remove-first 'b '(e f g)) '(e f g))
      (same (c1:remove-first 'x '()) '())
      (same (c1:suffix-after-first 'b '(a b c b)) '(c b))
      (same (c1:suffix-after-first 'z '(a b)) '())
      (same (c1:remove-all 'a '(a b a c a)) '(b c))
      (for ([e '(x y (lambda (x) (x y)) (lambda (y) (x y))
                   ((lambda (x) x) (x y)) (lambda (y) (lambda (z) (x (y z)))))]
            [want '(#t #f #f #t #t #t)]) (same (c1:occurs-free? 'x e) want))
      (same (c1:vector-sum #()) 0)
      (same (c1:vector-sum #(7 -2 0 5)) 10))
    (test-case "substitution and nested list contracts"
      (for ([xs '(() (a) ((a b) () (a (c a))))])
        (define expected (let walk ([x xs])
                           (cond [(null? x) '()] [(symbol? x) (if (eq? x 'a) 'new x)]
                                 [else (map walk x)])))
        (for ([impl (list c1:subst c1:subst-inline c1:subst-map)]) (same (impl 'new 'a xs) expected)))
      (same (c1:duple 2 3) '(3 3))
      (same (c1:duple 4 '(ha ha)) '((ha ha) (ha ha) (ha ha) (ha ha)))
      (same (c1:duple 0 '(blah)) '())
      (same (c1:invert '((a 1) (a 2) (1 b) (2 b))) '((1 a) (2 a) (b 1) (b 2)))
      (same (c1:down '(1 2 3)) '((1) (2) (3)))
      (same (c1:down '((a) (fine) (idea))) '(((a)) ((fine)) ((idea))))
      (same (c1:down '(a (more (complicated)) object)) '((a) ((more (complicated))) (object)))
      (same (c1:swapper 'a 'd '(a b c d)) '(d b c a))
      (same (c1:swapper 'a 'd '(a d () c d)) '(d a () c a))
      (same (c1:swapper 'x 'y '((x) y (z (x)))) '((y) x (z (y))))
      (same (c1:list-set '(a b c d) 2 '(1 2)) '(a b (1 2) d))
      (same (list-ref (c1:list-set '(a b c d) 3 '(1 5 10)) 3) '(1 5 10))
      (fails (lambda () (c1:list-set '() 0 'x)))
      (same (c1:count-occurrences 'x '((f x) y (((x z) x)))) 3)
      (same (c1:count-occurrences 'x '((f x) y (((x z) () x)))) 3)
      (same (c1:count-occurrences 'w '((f x) y (((x z) x)))) 0)
      (same (c1:product '(a b c) '(x y)) '((a x) (a y) (b x) (b y) (c x) (c y)))
      (same (c1:product '(a) '()) '())
      (same (c1:filter-in number? '(a 2 (1 3) b 7)) '(2 7))
      (same (c1:filter-in symbol? '(a (b c) 17 foo)) '(a foo))
      (same (c1:list-index number? '(a 2 (1 3) b 7)) 1)
      (same (c1:list-index symbol? '(a (b c) 17 foo)) 0)
      (same (c1:list-index number? '(a (b c))) #f)
      (same (c1:every? number? '(a b c 3 e)) #f)
      (same (c1:every? number? '(1 2 3 5 4)) #t)
      (same (c1:every? number? '()) #t)
      (same (c1:exists? number? '(a b c 3 e)) #t)
      (same (c1:exists? number? '(a b c d e)) #f)
      (same (c1:exists? number? '()) #f)
      (define visits '())
      (same (c1:exists? (lambda (v) (set! visits (cons v visits)) (= v 2)) '(1 2 3)) #t)
      (same (reverse visits) '(1 2))
      (same (c1:up '((1 2) (3 4))) '(1 2 3 4))
      (same (c1:up '((x (y)) z)) '(x (y) z))
      (same (c1:up '(() a (b))) '(a b))
      (same (c1:up '((a . b))) '((a . b)))
      (same (c1:flatten '((a b) c (((d)) e))) '(a b c d e))
      (same (c1:flatten '(() ())) '())
      (same (c1:flatten '(a b c)) '(a b c))
      (same (c1:flatten '(a b (() (c)))) '(a b c))
      (same (c1:list-index symbol? '(1 2 (a b) 3)) #f))
    (test-case "exhaustive small lists against independent host operations"
      (for ([xs small-lists])
        (same (c1:list-length xs) (length xs))
        (same (c1:sort xs) (sort xs <))
        (same (c1:sort/predicate > xs) (sort xs >))
        (same (c1:number-elements xs) (for/list ([x xs] [i (in-naturals)]) (list i x)))
        (same (c1:number-elements/g xs) (c1:number-elements xs))
        (same (c1:up (c1:down xs)) xs)
        (same (c1:vector-sum (list->vector xs)) (apply + xs)))
      (same (c1:merge '(1 4) '(1 2 8)) '(1 1 2 4 8))
      (same (c1:merge '(35 62 81 90 91) '(3 83 85 90)) '(3 35 62 81 83 85 90 90 91))
      (for* ([xs (take small-lists 20)] [ys (take small-lists 20)])
        (same (c1:merge (sort xs <) (sort ys <)) (sort (append xs ys) <))))
    (test-case "tree traces and distinct tree contracts"
      (define t '(foo (bar 26 12) (baz 11 (quux 117 14))))
      (same (c1:contents-of (c1:leaf 3)) 3)
      (same (c1:contents-of t) 'foo)
      (same (c1:double-tree t) '(foo (bar 52 24) (baz 22 (quux 234 28))))
      (same (c1:mark-leaves-with-red-depth '(red (bar 26 12) (red 11 (quux 117 14))))
            '(red (bar 1 1) (red 2 (quux 2 2))))
      (same (c1:mark-leaves-with-red-depth 42) 0)
      (same (c1:number-leaves t) '(foo (bar 0 1) (baz 2 (quux 3 4))))
      (same (c1:number-leaves 42) 0)
      (define bst '(14 (7 () (12 () ())) (26 (20 (17 () ()) ()) (31 () ()))))
      (same (c1:path 17 bst) '(right left left))
      (same (c1:path 14 bst) '())
      (fails (lambda () (c1:path 99 bst))))
    (test-case "natural interfaces, canonical carry and borrow"
      (for ([base '(2 3 10 16 256)])
        (define a (c2:make-bigits base))
        (define enc (c2:number-api-encode a)) (define dec (c2:number-api-decode a))
        (for ([n (in-range 260)])
          (same (dec (enc n)) n)
          (same (dec ((c2:number-api-succ a) (enc n))) (add1 n))
          (when (> n 0) (same (dec ((c2:number-api-pred a) (enc n))) (sub1 n))))
        (same ((c2:number-api-pred a) (enc base)) (list (sub1 base)))
        (fails (lambda () ((c2:number-api-pred a) '())))
        (same (dec (c2:nat-factorial a (enc 6))) 720)
        (same (dec (c2:nat-factorial a (enc 0))) 1))
      (for ([a (list c2:unary-api c2:native-api (c2:make-bigits 16))])
        (define enc (c2:number-api-encode a)) (define dec (c2:number-api-decode a))
        (for* ([x (in-range 10)] [y (in-range 10)])
          (same (dec (c2:nat-plus a (enc x) (enc y))) (+ x y))
          (same (dec (c2:nat-times a (enc x) (enc y))) (* x y))))
      (same ((c2:number-api-encode (c2:make-bigits 16)) 258) '(2 0 1))
      (fails (lambda () (c2:make-bigits 1))))
    (test-case "diff-tree laws on noncanonical, negative and shared inputs"
      (define trees
        (let grow ([d 2])
          (if (zero? d) '((one))
              (let ([prev (grow (sub1 d))])
                (cons '(one) (for*/list ([a prev] [b prev]) (list 'diff a b)))))))
      (for ([t trees])
        (define n (c2:dt-value t))
        (same (c2:dt-value (c2:dt-succ t)) (add1 n))
        (same (c2:dt-value (c2:dt-pred t)) (sub1 n))
        (same (c2:dt-zero? t) (= n 0))
        (for ([u trees]) (same (c2:dt-value (c2:diff-tree-plus t u)) (+ n (c2:dt-value u)))))
      (define input '(diff (one) (diff (one) (one))))
      (same (eq? (cadr (c2:diff-tree-plus input input)) input) #t))
    (test-case "same clients across seven environment representations"
      (for ([a (list c2:alist-api c2:parallel-api c2:flat-api c2:hash-api c2:rib-api
                     c2:env3-api c2:datatype-env-api)])
        (define empty ((c2:env-api-empty a)))
        (define old ((c2:env-api-extend a) 'x 7 empty))
        (define newest ((c2:env-api-extend* a) '(y x flag) '(8 99 #f) old))
        (same ((c2:env-api-empty? a) empty) #t)
        (same ((c2:env-api-empty? a) newest) #f)
        (same ((c2:env-api-lookup a) newest 'x) 99)
        (same ((c2:env-api-lookup a) newest 'y) 8)
        (same ((c2:env-api-lookup a) old 'x) 7)
        (same ((c2:env-api-lookup a) newest 'flag) #f)
        (same ((c2:env-api-has? a) newest 'flag) #t)
        (same ((c2:env-api-has? a) newest 'missing) #f)
        (fails (lambda () ((c2:env-api-lookup a) newest 'missing)))
        (same ((c2:env-api-lookup a) ((c2:env-api-extend* a) '(x x) '(1 2) old) 'x) 1)
        (same ((c2:env-api-empty? a) ((c2:env-api-extend* a) '() '() empty)) #t))
      (fails (lambda () (c2:alist-extend* '(x) '() '())))
      (define e (c2:tag-extend 'd 6 (c2:tag-extend 'y 8 (c2:tag-empty))))
      (same (c2:tag-lookup e 'y) 8)
      (fails (lambda () (c2:tag-lookup e 'z)) #rx"searched \\(d y\\); original environment")
      (fails (lambda () (c2:tag-lookup '(bad) 'z)) #rx"invalid frame")
      (same (c2:env2-empty? (c2:env2-empty)) #t)
      (same (c2:env2-lookup (c2:env2-extend 'x #f (c2:env2-empty)) 'x) #f))
    (test-case "all stack interfaces and empty observers"
      (for ([ops (list (list c2:empty-stack c2:push c2:top c2:pop c2:empty-stack?)
                       (list c2:proc-empty-stack c2:proc-push c2:proc-top c2:proc-pop c2:proc-empty-stack?)
                       (list c2:dt-empty-stack c2:dt-push c2:dt-top c2:dt-pop c2:dt-empty-stack?))])
        (define e ((first ops))) (define s ((second ops) #f e))
        (same ((third ops) s) #f) (same ((fourth ops) s) e)
        (same ((fifth ops) e) #t) (same ((fifth ops) s) #f)
        (fails (lambda () ((third ops) e))) (fails (lambda () ((fourth ops) e)))))
    (test-case "free variables across four AST interfaces"
      (for ([a (list c2:list-lc-api c2:flat-lc-api c2:vector-lc-api c2:procedure-lc-api)])
        (define v (c2:lc-api-var a)) (define lam (c2:lc-api-lam a)) (define app (c2:lc-api-app a))
        (define e (app (lam 'x (v 'x)) (app (v 'x) (v 'y))))
        (same (c2:free?/api a 'x e) #t)
        (same (c2:free?/api a 'y e) #t)
        (same (c2:free?/api a 'x (lam 'x e)) #f)
        (same (c2:free?/api a 'z e) #f)))
    (test-case "sequence zipper movement, insertion and edges"
      (define s '(6 (5 4 3 2 1) (7 8 9)))
      (same (c2:number->sequence 7) '(7 () ()))
      (same (c2:seq-current s) 6)
      (same (c2:seq-left s) '(5 (4 3 2 1) (6 7 8 9)))
      (same (c2:seq-right s) '(7 (6 5 4 3 2 1) (8 9)))
      (same (c2:seq-insert-left 13 s) '(6 (13 5 4 3 2 1) (7 8 9)))
      (same (c2:seq-insert-right 13 s) '(6 (5 4 3 2 1) (13 7 8 9)))
      (same (c2:seq-right (c2:seq-left s)) s)
      (same (c2:seq-left (c2:seq-right s)) s)
      (fails (lambda () (c2:seq-left (c2:number->sequence 7))))
      (fails (lambda () (c2:seq-right (c2:number->sequence 7)))))
    (test-case "tree zipper preserves edits when returning to parent"
      (define t (c2:insert-to-right 14 (c2:insert-to-left 12 (c2:number->bintree 13))))
      (same t '(13 (12 () ()) (14 () ())))
      (same (c2:move-to-left t) '(12 () ()))
      (same (c2:current-element (c2:move-to-left t)) 12)
      (same (c2:at-leaf? (c2:move-to-right (c2:move-to-left t))) #t)
      (same (c2:insert-to-left 15 t) '(13 (15 (12 () ()) ()) (14 () ())))
      (define z (c2:zip-insert-right 14 (c2:zip-insert-left 12 (c2:zip-number 13))))
      (same (c2:at-root? z) #t)
      (same (c2:move-up (c2:zip-left z)) z)
      (same (c2:move-up (c2:zip-right z)) z)
      (same (car (c2:move-up (c2:zip-insert-right 99 (c2:zip-left z))))
            '(13 (12 () (99 () ())) (14 () ())))
      (same (c2:zip-leaf? (c2:zip-left (c2:zip-left z))) #t)
      (same (c2:zip-current (c2:zip-left z)) 12)
      (fails (lambda () (c2:move-up z)))
      (fails (lambda () (c2:zip-left (c2:zip-left (c2:zip-left z))))))
    (test-case "datatype validation and negative leaf-sum maxima"
      (same (c2:identifier? 'lambda) #f) (same (c2:identifier? 'x) #t)
      (same (c2:identifier? 7) #f)
      (fails (lambda () (c2:var-exp 'lambda)))
      (fails (lambda () (c2:lambda-exp 'x 7)))
      (define t1 (c2:interior-node 'foo (c2:leaf-node 2) (c2:leaf-node 3)))
      (define t2 (c2:interior-node 'bar (c2:leaf-node -1) t1))
      (define t3 (c2:interior-node 'baz t2 (c2:leaf-node 1)))
      (same (c2:bintree-to-list (c2:interior-node 'a (c2:leaf-node 3) (c2:leaf-node 4)))
            '(interior-node a (leaf-node 3) (leaf-node 4)))
      (same (c2:max-interior t2) 'foo) (same (c2:max-interior t3) 'baz)
      (same (c2:max-interior (c2:interior-node 'root (c2:leaf-node -5)
                              (c2:interior-node 'best (c2:leaf-node -2) (c2:leaf-node -1)))) 'best)
      (fails (lambda () (c2:max-interior (c2:leaf-node 1))))
      (define rb (c2:a-red-blue-tree
                    (c2:red-node (c2:rb-leaf 77)
                      (c2:blue-node (list (c2:rb-leaf 66)
                                         (c2:red-node (c2:rb-leaf 1) (c2:rb-leaf 2))
                                         (c2:blue-node '()))))))
      (same (c2:rb->list (c2:mark-red-depth rb)) '(red 1 (blue 1 (red 2 2) (blue)))))
    (test-case "parser exact shapes, rejection and finite generated roundtrips"
      (define expressions
        (let grow ([n 2])
          (if (zero? n) '(x y)
              (let ([prev (grow (sub1 n))])
                (append '(x y) (map (lambda (b) (list 'lambda '(x) b)) prev)
                        (for*/list ([f prev] [x prev]) (list f x)))))))
      (for ([e expressions]) (same (c2:unparse-expression (c2:parse-expression e)) e))
      (for ([bad '(7 #t () lambda (a b c) (lambda) (lambda (x y) x)
                    (lambda (lambda) x) (lambda (x) x y) (lambda x x) (x . y) (x ()))])
        (fails (lambda () (c2:parse-expression bad)) #rx"invalid lambda-calculus syntax"))
      (same (c2:unparse-expression c2:ast-example-1) '((lambda (a) (a b)) c))
      (same (c2:unparse-expression c2:ast-example-2)
            '(lambda (x) (lambda (y) ((lambda (x) (x y)) x))))
      (same (c2:unparse/string (c2:parse-expression '(lambda (x) (f (f x))))) "proc x => f(f(x))")
      ;; This ambiguity is a property of the printed alternate grammar.
      (same (c2:unparse/string (c2:parse-expression '((lambda (x) x) y)))
            (c2:unparse/string (c2:parse-expression '(lambda (x) (x y)))))
      (for ([e '((f) (lambda () x) (f x y) (lambda (x y) (x y)) (lambda (x x) x))])
        (same (c2:unparse-multi (c2:parse-multi e)) e))
      (for ([bad '(() (lambda) (lambda (lambda) x) (lambda (x) x y) (f . x))])
        (fails (lambda () (c2:parse-multi bad)))))
    (test-case "prefix parser leftovers and nontrivial negative subtrees"
      (define tokens '(- - 3 2 - 4 - 12 7))
      (same (c2:prefix-value (c2:parse-prefix tokens)) 2)
      (same (c2:prefix->tokens (c2:parse-prefix tokens)) tokens)
      (let-values ([(e rest) (c2:parse-prefix-part '(3 - 4 2))])
        (same (c2:prefix-value e) 3) (same rest '(- 4 2)))
      (for* ([x (in-range -5 6)] [y (in-range -5 6)])
        (same (c2:prefix-value (c2:parse-prefix (list '- x y))) (- x y)))
      (for ([bad '(() (-) (- 3) (3 4) (- 3 4 5) (x) (3 . 4))])
        (fails (lambda () (c2:parse-prefix bad)))))))
(define failures (run-tests suites))
(write-json (hasheq 'status (if (= failures 0) "passed" "failed")
                    'assertions assertions 'failures failures 'racket (version)))
(newline)
(exit (if (= failures 0) 0 1))

#lang racket
(require (except-in rackunit check) rackunit/text-ui json racket/match
         "chapter09.rkt" "chapter09_examples.rkt"
         (prefix-in r: "chapter09_runtime.rkt") (prefix-in t: "chapter09_types.rkt"))
(define assertions 0)
(define-syntax-rule (is actual expected) (begin (set! assertions (add1 assertions)) (check-equal? actual expected)))
(define (reject thunk [kind #f])
  (set! assertions (add1 assertions))
  (check-exn (lambda (e) (and (exn:fail:oo? e) (or (not kind) (eq? kind (exn:fail:oo-kind e))))) thunk))
(define (typed p type value [options (hash)])
  (is (check p #:options options) type)
  (define actual (run p #:typed? #t #:options options))
  (is (if (r:object? actual) (r:rclass-name (r:object-class* actual)) actual) value))
(define (has-kind? value) (lambda (e) (and (exn:fail:oo? e) (eq? (exn:fail:oo-kind e) value))))
(define suite
 (test-suite "chapter9"
  (test-case "complete original source programs and explicit completion"
   (for ([row (list (list figure9-1 '((3 -3) (5 -5))) (list figure9-2 12) (list figure9-3 '((6 8) (20 40) 87))
                         (list figure9-4 '(101 102 101 999)) (list figure9-5 172) (list figure9-6 33)
                         (list override-self '(11 22 22)) (list figure9-8-complete '(11 22 7 8)))])
     (is (run (car row)) (cadr row)))
   (typed figure9-12 '(listof int) '(12 100))
   (is (execution-events (run/trace figure9-6)) '((invoke c3 c1 initialize) (invoke c3 c2 m3) (invoke c3 c1 m1) (invoke c3 c3 m2))))
  (test-case "field locations, aliases and fresh parameter locations"
   (is (run "class A extends object field x method initialize(v)set x=v method set(v)set x=v method get()x let a=new A(1) b=new A(2) in let alias=a in begin send alias set(7);list(send a get(),send b get()) end") '(7 2))
   (is (run "class A extends object field x method initialize(v)set x=v method change(x)begin set x=99;fieldref self x end let z=7 in let a=new A(3) in list(send a change(z),z)") '(3 7))
   (define trace (run/trace figure9-8-complete))
   (is (class-layout trace 'c3) '((0 c1 x) (1 c1 y) (2 c2 y) (3 c3 x) (4 c3 z)))
   (for ([mode '(name record)]) (is (run figure9-4 #:options (hash 'object-class mode)) '(101 102 101 999)))
   (reject (lambda () (run "class A extends object field x method initialize()1 method get()x send new A() get()")) 'uninitialized)
   (reject (lambda () (run "new object()")) 'method)
   (reject (lambda () (run "send 1 nope()")) 'object)
   (reject (lambda () (run "class A extends object method initialize()1 send new A() nope()")) 'method)
   (reject (lambda () (run "class A extends object method initialize()1 new A(7)")) 'arity)
   (is (execution-output (run/trace "class A extends object method initialize()1 method m(x,y)0 send begin print(9);new A() end m(print(1),print(2))")) '(1 2 9))
   (is (execution-output (run/trace "(begin print(9);proc(a,b)0 end print(1) print(2))")) '(9 1 2))
   (is (execution-output (run/trace "print(-3)")) '(-3))
   (reject (lambda () (run "print(zero?(0))")) 'number)
   (reject (lambda () (run "self")) 'self)
   (reject (lambda () (run "super m()")) 'super))
  (test-case "queues, private object state and shared counter"
   (is (run exercise9-1) '(2 2 4)) (is (run exercise9-2) 0)
   (is (run (string-append oddeven " let o=new oddeven() in send o odd(13)")) 1)
   (for ([n (in-range 1 24)])
     (define enqueues (apply string-append (for/list ([i (in-range n)]) (format "send q enqueue(~a);" i))))
     (define dequeues (string-join (make-list n "send q dequeue()") ","))
     (is (run (string-append queue-definitions " let q=new queue() in begin " enqueues "list(" dequeues ") end")) (range n)))
   (reject (lambda () (run (string-append queue-definitions " send new queue() dequeue()"))) 'empty)
   (is (run (string-append queue-definitions " let q=new queue() in begin send q enqueue(1);send q enqueue(2);send q dequeue();send q enqueue(3);list(send q dequeue(),send q dequeue(),send q empty?()) end")) '(2 3 #t)))
  (test-case "lexical super, named access and host-only fields"
   (is (run exercise9-9) '(7 2)) (is (run exercise9-10) '(22 11 2 7))
   (is (run "class A extends object method initialize()1 method m()11 class B extends A method m()22 method f()proc()super m() class C extends B method m()33 let f=send new C() f() in (f)") 11)
   (reject (lambda () (run "class A extends object field x method initialize()set x=7 class B extends A method get()x send new B() get()" #:options (hash 'host-fields-only? #t))) 'unbound)
   (is (run "class A extends object field x method initialize()set x=7 method get()x class B extends A send new B() get()" #:options (hash 'host-fields-only? #t)) 7)
   (reject (lambda () (run "class A extends object method initialize()1 class B extends object method initialize()1 named-send A new B() initialize()")) 'receiver))
  (test-case "access checks, final methods and static self"
   (is (run exercise9-11) '(17 23)) (is (run exercise9-12) '(17 23))
   (for ([p (list (string-replace exercise9-11 "list(send b reveal(),send b inherited-access())" "send b secret()")
                  (string-replace exercise9-11 "list(send b reveal(),send b inherited-access())" "send b middle()")
                  (string-replace exercise9-12 "list(send b reveal(),send b inherited-access())" "fieldref b secret")
                  (string-replace exercise9-12 "list(send b reveal(),send b inherited-access())" "fieldset b shared=9"))])
     (reject (lambda () (run p)) 'access))
   (reject (lambda () (run "class A extends object private field x method initialize()set x=7 class B extends A method bad()x send new B() bad()")) 'unbound)
   (is (run exercise9-13) 1)
   (reject (lambda () (run (string-append (string-replace exercise9-13 "let o=new oddeven() in send o odd(13)" "") " class B extends oddeven method even(n)0 new B()"))) 'final)

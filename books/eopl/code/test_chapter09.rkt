  (test-case "static locations and overload preprocessing"
   (is (run exercise9-15) '(1 2))
   (is (run "class A extends object static a=3 static b=+(a,4) method initialize()1 method get()b send new A() get()") 7)
   (reject (lambda () (run "class A extends object static x=fieldref self y field y method initialize()1 0")) 'self)
   (reject (lambda () (run exercise9-16)) 'duplicate)
   (is (run exercise9-16 #:options (hash 'overload? #t)) '(0 7))
   (is (run exercise9-16 #:options (hash 'mangle? #t)) '(0 7))
   (is (execution-output (run/trace "class A extends object method initialize(a,b)print(3) new A(print(1),print(2))" #:options (hash 'mangle? #t))) '(1 2 3))
   (for ([p (list figure9-1 figure9-2 figure9-4 figure9-6 exercise9-9 exercise9-10)])
     (is (run p #:options (hash 'mangle? #t)) (run p)))
   (is (run "class A extends object method initialize()1 method initialize(x)2 class B extends A method initialize()3 method get()7 send new B(9) get()" #:options (hash 'overload? #t)) 7)
   (is (run "class A extends object method initialize()1 method f:@1(x)x let a=new A() in send a f:@1(7)" #:options (hash 'mangle? #f)) 7))
  (test-case "local class identities and method environment sharing"
   (is (run exercise9-17) '(11 22 11))
   (is (run "let seed=7 in letclass C=extends object static n=seed method initialize()1 method get()n in send new C() get()") 7)
   (define tr (run/trace figure9-8-complete))
   (define cs (execution-classes tr)) (define c1 (r:lookup-class cs 'c1)) (define c2 (r:lookup-class cs 'c2))
   (define m1 (hash-ref (r:rclass-table c1) 'm2)) (define m2 (hash-ref (r:rclass-table c2) 'm2))
   (is (eq? m1 m2) #t) (is (eq? (r:rclass-view (r:rmethod-host m1)) (r:rclass-view c1)) #t)
   (define s (run/trace figure9-8-complete #:options (hash 'stable? #t)))
   (is (method-slots s 'c1) '((0 initialize c1) (1 m1 c1) (2 m2 c1)))
   (is (method-slots s 'c2) '((0 initialize c2) (1 m1 c2) (2 m2 c1) (3 m3 c2)))
   (is (method-slots s 'c3) '((0 initialize c3) (1 m1 c2) (2 m2 c1) (3 m3 c3))))
  (test-case "lexical addresses preserve values, writes, closures and recursive groups"
   (for ([p (list figure9-1 figure9-2 figure9-3 figure9-4 figure9-6 figure9-8-complete exercise9-9 exercise9-10 exercise9-17
                  "let x=7 in let x=1 y=x in -(y,x)"
                  "let x=3 in let f=proc(z)begin set x=+(x,z);x end in begin (f 2);(f 4) end"
                  "letrec f(x)=if zero?(x) then 1 else (g -(x,1)) g(x)=if zero?(x) then 0 else (f -(x,1)) in (f 12)")])
     (is (run p #:options (hash 'lexical? #t)) (run p)))
   (is (run figure9-12 #:typed? #t #:options (hash 'lexical? #t)) '(12 100))
   (define translated (translate (pgm-body (parse "let x=7 in let y=9 in -(x,y)")) '((i v x)) (hash) #f #:lexical? #t))
   (is translated (E 'let (list (cons 'x (E 'const 7))) (E 'let (list (cons 'y (E 'const 9))) (E 'prim '- (list (E 'lexref 1 0) (E 'lexref 0 0))))))
   (define closure (run "let x=7 in proc(y)+(x,y)" #:options (hash 'lexical? #t)))
   (is (map r:frame-names (r:closure-env closure)) '(() ()))
   (define nameless (run/trace figure9-1 #:options (hash 'lexical? #t)))
   (is (hash-ref (execution-statistics nameless) 'symbol-lookups 0) 0)
   (reject (lambda () (run exercise9-15 #:options (hash 'lexical? #t))) 'compile)
   (reject (lambda () (run "proc(x)y" #:options (hash 'lexical? #t))) 'unbound))
  (test-case "lookup work and statically selected methods"
   (for ([n '(8 64 256)])
     (define linear (run/trace (lookup-workload n)))
     (define fast (run/trace (lookup-workload n) #:options (hash 'method-lookup 'hash 'stable? #t)))
     (is (execution-value linear) 0) (is (execution-value fast) 0)
     (is (hash-ref (execution-statistics linear) 'method-probes) (+ 1 (* (add1 n) 128)))
     (is (hash-ref (execution-statistics fast) 'method-probes) 129))
   (for ([options (list (hash 'direct-super? #t) (hash 'named-slots? #t) (hash 'direct-super? #t 'named-slots? #t 'lexical? #t))])
     (is (run figure9-6 #:options options) 33) (is (run exercise9-10 #:options options) '(22 11 2 7)))
   (define fast (run/trace exercise9-10 #:options (hash 'named-slots? #t)))
   (is (hash-ref (execution-statistics fast) 'slot-reads) 1)
   (is (run "class A extends object method initialize()1 method f()named-send B new B() m() class B extends object method initialize()1 method m()7 send new A() f()" #:options (hash 'named-slots? #t)) 7))
  (test-case "binary methods and coordinate/color matrix"
   (is (run exercise9-25) '(#t #t #t #t #f))
   (define values (list (list #f 0 0 0) (list #f 1 0 0) (list #t 0 0 7) (list #t 0 0 8) (list #t 1 0 7)))
   (define (point v) (if (car v) (format "new colorpoint(~a,~a,~a)" (cadr v) (caddr v) (cadddr v)) (format "new point(~a,~a)" (cadr v) (caddr v))))
   (for* ([a values] [b values])
     (define expected (and (= (cadr a) (cadr b)) (= (caddr a) (caddr b)) (or (not (and (car a) (car b))) (= (cadddr a) (cadddr b)))))
     (is (run (string-append point-definitions " let a=" (point a) " b=" (point b) " in send a similarpoints(b)")) expected))
   (define wrong (string-replace point-definitions "if instanceof pt colorpoint then equal?(send pt getcolor(),color) else zero?(0)" "equal?(send pt getcolor(),color)"))
   (reject (lambda () (run (string-append wrong " let a=new colorpoint(3,4,7) b=new point(3,4) in send a similarpoints(b)"))) 'method))

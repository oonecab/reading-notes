  (test-case "function subtyping and legal/illegal overrides"
   (define declarations "interface I method int m() class A extends object method int initialize()1 method int m()7 class B extends A implements I method int m()9 ")
   (define cs (checked-classes (check/compiled (string-append declarations "0"))))
   (for ([t '(int bool void string A B I object)]) (is (subtype? t t cs) #t))
   (is (subtype? 'B 'A cs) #t) (is (subtype? 'B 'I cs) #t) (is (subtype? 'I 'object cs) #t) (is (subtype? 'A 'B cs) #f)
   (is (subtype? '(proc (A) B) '(proc (B) A) cs) #t) (is (subtype? '(proc (B) A) '(proc (A) B) cs) #f)
   (is (subtype? '(listof B) '(listof A) cs) #f)
   (typed (string-append declarations "let f=proc(x:A)send x m() in (f new B())") 'int 9)
   (reject (lambda () (check "class A extends object method int initialize()1 method int m(x:int)x class B extends A method bool m(x:int)zero?(x) 0")) 'override)
   (reject (lambda () (check "class A extends object method int initialize()1 method int m(x:object)1 class B extends A method int m(x:B)2 0")) 'override)
   (typed "class A extends object method int initialize()1 method A m(x:A)x class B extends A method B m(x:object)new B() send new B() m(new A())" 'B
          'B))
  (test-case "cast/instanceof object targets and interface counterexample"
   (for ([p '("cast 1 object" "instanceof zero?(0) object" "cast new object() int" "interface I cast new object() I" "instanceof 1 missing")]) (reject (lambda () (check p))))
   (define base "interface I method int m() class A extends object implements I method int initialize()1 method int m()7 class B extends A class C extends object method int initialize()1 ")
   (typed (string-append base "let f=proc(x:I)send cast x A m() in (f new A())") 'int 7 (hash 'casts 'related))
   (typed (string-append base "instanceof new B() A") 'bool #t (hash 'casts 'related))
   (typed (string-append base "instanceof new A() B") 'bool #f (hash 'casts 'related))
   (reject (lambda () (check (string-append base "cast new A() C") #:options (hash 'casts 'related))) 'cast)

#lang racket
(require rackunit rackunit/text-ui json
         (prefix-in s: "chapter04.rkt")
         (prefix-in e: "chapter04_explicit.rkt")
         (prefix-in t: "chapter04_statements.rkt"))
(define assertions 0)
(define (same got expected) (set! assertions (add1 assertions)) (check-equal? got expected))
(define (fails thunk [pattern #rx"."])
  (set! assertions (add1 assertions)) (check-exn pattern thunk))
(define (N text [mode 'value]) (s:datum (s:run text #:mode mode)))
(define (E text [mode 'constant]) (s:datum (e:run text #:setref-result mode)))
(define (S text #:input [input ""]) (t:statement-result-output (t:run text #:input input)))
(define counter "let g = let counter = newref(0) in proc(dummy) begin setref(counter,-(deref(counter),-1)); deref(counter) end in let a = (g 11) in let b = (g 11) in -(a,b)")
(define reset-counter "let g = proc(dummy) let counter = newref(0) in begin setref(counter,-(deref(counter),-1)); deref(counter) end in let a = (g 11) in let b = (g 11) in -(a,b)")
(define swap "let swap = proc(x) proc(y) let temp = x in begin set x = y; set y = temp end in let a = 33 in let b = 44 in begin ((swap a) b); -(a,b) end")
(define lazy-effects "let c = 0 in let f = proc(x) -(x,x) in (f begin set c = -(c,-1); c end)")
(define lazy-fixed "let makerec = proc(f) let d = proc(x) (f (x x)) in (f (d d)) in let maketimes4 = proc(f) proc(x) if zero?(x) then 0 else -((f -(x,1)),-4) in let times4 = (makerec maketimes4) in (times4 3)")
(define eager-fixed "let makerec = proc(f) let d = proc(x) proc(z) ((f (x x)) z) in proc(n) ((f (d d)) n) in let maketimes4 = proc(f) proc(x) if zero?(x) then 0 else -((f -(x,1)),-4) in let times4 = (makerec maketimes4) in (times4 3)")
(define tests
  (test-suite "EOPL chapter 4"
    (test-case "explicit source examples, lifetime and reference chains"
      (same (E counter) -1) (same (E reset-counter) 0)
      (same (length (e:answer-store (e:run/details counter))) 1)
      (same (length (e:answer-store (e:run/details reset-counter))) 2)
      (same (E "let x = newref(newref(0)) in begin setref(deref(x),11); deref(deref(x)) end") 11)
      (define nested (e:run/details "let x = newref(newref(0)) in x"))
      (same (map s:datum (e:answer-store nested)) '(0 (ref 0)))
      (same (E "let x = newref(22) in let f = proc(z) let zz = newref(-(z,deref(x))) in deref(zz) in -((f 66),(f 55))") 11)
      (same (E "let x = newref(0) in letrec even(dummy) = if zero?(deref(x)) then 1 else begin setref(x,-(deref(x),1)); (odd 888) end odd(dummy) = if zero?(deref(x)) then 0 else begin setref(x,-(deref(x),1)); (even 888) end in begin setref(x,13); (odd 888) end") 1))
    (test-case "pure store sequencing: test, rator, operands, list, begin"
      (same (E "let r = newref(0) in -(begin setref(r,1); deref(r) end,begin setref(r,2); deref(r) end)") -1)
      (same (E "let r = newref(0) in if zero?(begin setref(r,7); 0 end) then deref(r) else missing") 7)
      (same (E "let r = newref(0) in (begin setref(r,9); proc(x) -(x,deref(r)) end begin setref(r,11); 20 end)") 9)
      (same (E "let r = newref(0) in list(begin setref(r,1); deref(r) end,begin setref(r,2); deref(r) end,deref(r))") '(1 2 2))
      (same (E "list()") '()) (same (E "begin 7 end") 7)
      (same (E "let r = newref(0) in begin setref(r,8); zero?(deref(r)) end") #f))
    (test-case "setref results including operand side effects"
      (define text "let r = newref(0) in setref(r,begin setref(r,9); 7 end)")
      (same (E text) 23) (same (E text 'rhs) 7) (same (E text 'old) 9)
      (for ([mode '(constant rhs old)])
        (same (map s:datum (e:answer-store (e:run/details text #:setref-result mode))) '(7))))
    (test-case "explicit many arguments and immutable store histories"
      (same (E "let f = proc(x,y,z) -(-(x,y),z) in (f 20 3 2)") 15)
      (same (E "let f = proc() 8 in (f)") 8)
      (define old (list (s:num-val 7) (s:num-val 8)))
      (define new (e:update-store old 0 (s:num-val 9)))
      (same (map s:datum old) '(7 8)) (same (map s:datum new) '(9 8))
      (fails (lambda () (E "let f = proc(x) x in (f)")) #rx"arity")
      (fails (lambda () (E "deref(1)")) #rx"reference")
      (fails (lambda () (e:apply-store old 2)) #rx"invalid"))
    (test-case "store representations, bounds, growth and capacity"
      (for ([backend '(list fixed vector)])
        (parameterize ([s:current-store (s:make-store backend 3)])
          (same (s:newref! (s:num-val 7)) 0)
          (same (s:newref! (s:num-val 8)) 1)
          (s:setref! 1 (s:num-val 9)) (same (s:num (s:deref! 1)) 9)
          (same (map s:datum (s:store-snapshot)) '(7 9))
          (fails (lambda () (s:deref! -1))) (fails (lambda () (s:setref! 2 (s:num-val 0))))
          (fails (lambda () (s:deref! 1/2)))))
      (parameterize ([s:current-store (s:make-store 'fixed 1)])
        (s:newref! (s:num-val 0)) (fails (lambda () (s:newref! (s:num-val 1))) #rx"capacity"))
      (parameterize ([s:current-store (s:make-store 'vector 1)])
        (for ([i (in-range 100)]) (same (s:newref! (s:num-val i)) i))
        (for ([i (in-range 100)]) (same (s:num (s:deref! i)) i))))
    (test-case "implicit source closures and assignment-built recursion"
      (same (N "let f = proc(x) proc(y) begin set x = -(x,-1); -(x,y) end in ((f 44) 33)") 12)
      (same (N "let g = let count = 0 in proc(dummy) begin set count = -(count,-1); count end in let a = (g 11) in let b = (g 11) in -(a,b)") -1)
      (same (N "let times4 = 0 in begin set times4 = proc(x) if zero?(x) then 0 else -((times4 -(x,1)),-4); (times4 3) end") 12)
      (same (N "let x = 11 in let f = proc(y) -(y,x) in let x = 99 in (f 22)") 11)
      (same (N "let x = 7 in let y = x in begin set y = 9; x end") 7))
    (test-case "parallel let and multiargument effect order"
      (same (N "let x = 7 in let x = 3 y = x in -(x,y)") -4)
      (same (N "let x = 0 in let a = begin set x = 7; 1 end b = x in b") 7)
      (same (N "let x = 0 in let f = proc(a,b) -(a,b) in (f begin set x = 1; x end begin set x = 2; x end)") -1)
      (same (N "let f = proc() 8 in (f)") 8)
      (fails (lambda () (N "let x = 1 x = 2 in x")) #rx"duplicate")
      (fails (lambda () (N "(proc(x,y) x 1)")) #rx"arity"))
    (test-case "mutual recursion and one persistent location per closure"
      (define text "letrec even(n) = if zero?(n) then 1 else (odd -(n,1) 0) odd(n,dummy) = if zero?(n) then 0 else (even -(n,1)) in (odd 13 0)")
      (for ([rec '(fresh cached)])
        (same (s:datum (s:execution-value (s:run/details text #:rec rec))) 1))
      (define stable (s:run/details "letrec f(x) = x in begin (f 1); (f 2) end"))
      (define fresh (s:run/details "letrec f(x) = x in begin (f 1); (f 2) end" #:rec 'fresh))
      (same (hash-ref (s:execution-metrics stable) 'closures) 1)
      (same (hash-ref (s:execution-metrics fresh) 'closures) 2)
      (same (hash-ref (s:execution-metrics stable) 'allocations) 6)
      (same (hash-ref (s:execution-metrics fresh) 'allocations) 7)
      (same (N "letrec f(x) = x in begin set f = proc(x) 99; (f 0) end") 99))
    (test-case "mixed bindings and dynamic assignment restoration"
      (same (s:datum (s:execution-value (s:run/details "let x = 1 in letmutable y = 2 in begin set y = 3; -(y,x) end" #:immutable-let? #t))) 2)
      (fails (lambda () (s:run/details "let x = 1 in set x = 2" #:immutable-let? #t)) #rx"immutable")
      (same (N "let x = 11 in let p = proc(y) -(y,x) in -(setdynamic x = 17 during (p 22),(p 13))") 3)
      (same (N "let x = 1 in list(setdynamic x = 2 during list(x,setdynamic x = 3 during x,x),x)") '((2 3 2) 1))
      (parameterize ([s:current-store (s:make-store)])
        (define env (s:binding 'x (s:newref! (s:num-val 11)) '()))
        (fails (lambda () (s:value-of (s:dynamic-exp 'x (s:const-exp 17) (s:var-exp 'missing)) env)) #rx"unbound")
        (same (s:num (s:read-variable env 'x)) 11)))
    (test-case "statement language exact four source examples"
      (same (S "var x,y; {x = 3; y = 4; print +(x,y)}") "7\n")
      (same (S "var x,y,z; {x = 3; y = 4; z = 0; while not(zero?(x)) {z = +(z,y); x = -(x,1)}; print z}") "12\n")
      (same (S "var x; {x = 3; print x; var x; {x = 4; print x}; print x}") "3\n4\n3\n")
      (same (S "var f,x; {f = proc(x,y) *(x,y); x = 3; print (f 4 x)}") "12\n")
      (fails (lambda () (S "var q; print q")) #rx"uninitialized")
      (same (S "{}") ""))
    (test-case "read, post-test loop and sequential initializers"
      (same (S "var x; {read x; print x}" #:input "42") "42\n")
      (same (S "var x; {read x; print x}" #:input "0") "0\n")
      (for ([input '("-1" "1/2" "word" "")])
        (fails (lambda () (S "var q; read q" #:input input)) #rx"nonnegative"))
      (same (S "var x; {x = 0; do {x = +(x,1)} while zero?(1); print x}") "1\n")
      (same (S "varinit x = 3 y = +(x,1); print y") "4\n")
      (fails (lambda () (S "varinit a = b b = 2; print a")) #rx"unbound")
      (same (S "varinit x = 3; varinit x = +(x,1); print x") "4\n"))
    (test-case "mutually recursive statement declarations and callable kinds"
      (same (S "block n = 5 procedure even(n) = if zero?(n) then 1 else (odd -(n,1)) procedure odd(n) = if zero?(n) then 0 else (even -(n,1)) in print (odd n) end") "1\n")
      (same (S "block total = 0 subroutine add(n) = {total = +(total,n)} subroutine countdown(n) = if zero?(n) {} {call add(n); call countdown(-(n,1))} in {call countdown(4); print total} end") "10\n")
      (fails (lambda () (S "block procedure f(x) = x in call f(1) end")) #rx"subroutine required")
      (fails (lambda () (S "block subroutine p(x) = print x in print (p 1) end")) #rx"procedure required")
      (fails (lambda () (S "block subroutine p(x) = print x in call p() end")) #rx"arity"))
    (test-case "pairs: variable cell vs shared object, both representations"
      (define text "let glo = pair(11,22) in let f = proc(loc) let d1 = setright(loc,left(loc)) in let d2 = setleft(glo,99) in -(left(loc),right(loc)) in (f glo)")
      (for ([layout '(two base)])
        (same (s:datum (s:execution-value (s:run/details text #:pairs layout))) 88))
      (same (N "let p = pair(1,2) in let f = proc(q) setleft(q,9) in begin (f p); left(p) end") 9)
      (same (N "let p = pair(1,2) in let f = proc(q) set q = pair(8,9) in begin (f p); left(p) end") 1)
      (same (N "let p = pair(1,2) in list(setleft(p,3),setright(p,4),left(p),right(p))") '(82 83 3 4)))
    (test-case "arrays, bounds and source increment example"
      (same (N "let a = newarray(2,-99) p = proc(x) let v = arrayref(x,1) in arrayset(x,1,-(v,-1)) in begin arrayset(a,1,0); (p a); (p a); arrayref(a,1) end") 2)
      (same (N "arraylength(newarray(0,9))") 0)
      (same (N "let a = newarray(2,7) in begin arrayset(a,1,9); list(arrayref(a,0),arrayref(a,1),arraylength(a)) end") '(7 9 2))
      (for ([i '(-1 2 100)])
        (fails (lambda () (N (format "let a = newarray(2,0) b = newarray(3,99) in arrayref(a,~a)" i))) #rx"bounds")
        (fails (lambda () (N (format "let a = newarray(2,0) in arrayset(a,~a,7)" i))) #rx"bounds"))
      (fails (lambda () (N "newarray(-1,0)")) #rx"nonnegative")
      (fails (lambda () (N "arrayref(1,0)")) #rx"array required"))
    (test-case "reference parameters, temporary operands, aliasing, mixed modes and letref"
      (same (N swap) -11) (same (N swap 'reference) 11)
      (same (N "let f = proc(x) set x = 44 in let g = proc(y) (f y) in let z = 55 in begin (g z); z end" 'reference) 44)
      (same (N "let b = 3 in let p = proc(x) proc(y) begin set x = 4; y end in ((p b) b)" 'reference) 4)
      (same (N "let a = 3 in let p = proc(x) set x = 4 in begin (p -(a,0)); a end" 'reference) 3)
      (same (N "let a = 3 in let f = procval(x) set x = 4 in begin (f a); a end" 'reference) 3)
      (same (N "let a = 3 in let f = procref(x) set x = 4 in begin (f a); a end") 4)
      (same (N "let a = 3 in letref b = a in begin set b = 9; a end") 9)
      (same (N "let a = 3 in letref b = -(a,0) in begin set b = 9; a end") 3)
      (same (N "let a = 3 in let f = proc(x,y) begin set x = 4; y end in (f a a)" 'reference) 4))
    (test-case "explicit variable references in a value language"
      (same (N "let a = 3 in let b = 4 in let swap = proc(x) proc(y) let temp = deref(x) in begin setref(x,deref(y)); setref(y,temp) end in begin ((swap ref a) ref b); -(a,b) end") 1)
      (same (N "let a = 3 in let r = ref a in begin set a = 9; deref(r) end") 9))
    (test-case "reference array operands resolve nested indices once"
      (same (N "let a = newarray(3,0) in let swap = proc(x) proc(y) let temp = x in begin set x = y; set y = temp end in begin arrayset(a,0,1); arrayset(a,1,7); arrayset(a,2,9); ((swap arrayref(a,arrayref(a,0))) arrayref(a,2)); list(arrayref(a,1),arrayref(a,2)) end" 'reference) '(9 7))
      (same (N "let a = newarray(2,0) i = 0 in let f = proc(x) begin set i = 1; set x = 9 end in begin (f arrayref(a,i)); list(arrayref(a,0),arrayref(a,1)) end" 'reference) '(9 0)))
    (test-case "value-result isolation, copy-out and same-destination order"
      (define text "let x = 3 in let f = proc(y) begin set x = 4; y end in begin (f x); x end")
      (same (N text 'reference) 4) (same (N text 'value-result) 3)
      (same (N "let a = 0 in let f = proc(x,y) begin set x = 1; set y = 2 end in begin (f a a); a end" 'value-result) 2)
      (fails (lambda () (N "(proc(x) x 7)" 'value-result)) #rx"variable operand"))
    (test-case "lazy effects, closure environments, skipped divergence and fixed points"
      (same (N lazy-effects 'name) -1) (same (N lazy-effects 'need) 0)
      (same (N "let x = 7 in let f = proc(z) let x = 99 in z in (f -(x,1))" 'need) 6)
      (define skip "letrec loop(x) = (loop -(x,-1)) in let f = proc(z) 11 in (f (loop 0))")
      (same (N skip 'name) 11) (same (N skip 'need) 11)
      (fails (lambda () (s:run/details skip #:mode 'value #:fuel 300)) #rx"fuel exhausted")
      (same (N lazy-fixed 'need) 12)
      (same (N eager-fixed 'value) 12) (same (N eager-fixed 'need) 12)
      (fails (lambda () (s:run/details lazy-fixed #:mode 'value #:fuel 500)) #rx"fuel exhausted")
      (define name-result (s:run/details lazy-effects #:mode 'name))
      (define need-result (s:run/details lazy-effects #:mode 'need))
      (same (hash-ref (s:execution-metrics name-result) 'forces) 2)
      (same (hash-ref (s:execution-metrics need-result) 'forces) 1))
    (test-case "thunk optimization and lazy let uses fresh cells"
      (define text "let f = proc(x,y) 11 in (f 7 proc(z) z)")
      (define plain (s:run/details text #:mode 'need))
      (define opt (s:run/details text #:mode 'need #:optimize-thunks? #t))
      (same (hash-ref (s:execution-metrics plain) 'thunks) 2)
      (same (hash-ref (s:execution-metrics opt) 'thunks 0) 0)
      (same (s:datum (s:execution-value opt)) 11)
      (same (N "lazylet x = missing in 7" 'need) 7)
      (same (N "let c = 0 in lazylet x = begin set c = -(c,-1); c end in list(x,x,c)" 'need) '(1 1 1))
      (same (N "let a = 3 in lazylet b = a in begin set b = 9; a end" 'need) 3))
    (test-case "independent finite arithmetic/state matrix across store backends"
      (for* ([x (in-range -3 4)] [y (in-range -3 4)] [backend '(list fixed vector)])
        (define text (format "let x = ~a in let f = proc(y) begin set x = +(x,y); -(x,y) end in (f ~a)" x y))
        (same (s:datum (s:execution-value (s:run/details text #:backend backend #:capacity 100))) x)
        (define result (e:run/details (format "let r = newref(~a) in begin setref(r,+(deref(r),~a)); deref(r) end" x y)))
        (same (s:num (e:answer-value result)) (+ x y))))))
(define failures (run-tests tests))
(write-json (hash 'status (if (zero? failures) "passed" "failed") 'failures failures 'assertions assertions))
(newline) (exit (if (zero? failures) 0 1))

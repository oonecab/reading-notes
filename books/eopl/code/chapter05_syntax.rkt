#lang racket
;; EOPL chapters 5/6: SLLGEN concrete syntax -> small, inspectable AST.
(require (except-in eopl define) (only-in eopl [define eopl:define]))
(provide (all-defined-out))
(eopl:define lexical
  '((white-space (whitespace) skip)
    (comment ("%" (arbno (not #\newline))) skip)
    (identifier (letter (arbno (or letter digit "_" "-" "?"))) symbol)
    (number (digit (arbno digit)) number)
    (number ("-" digit (arbno digit)) number)))
(eopl:define grammar
 '((program (expression) a-program)
   (expression (number) const-exp)
   (expression (identifier) var-exp)
   (expression ("emptylist") empty-exp)
   (expression ("-" "(" expression "," expression ")") diff-exp)
   (expression ("*" "(" expression "," expression ")") times-exp)
   (expression ("/" "(" expression "," expression ")") divide-exp)
   (expression ("+" "(" (separated-list expression ",") ")") sum-exp)
   (expression ("zero?" "(" expression ")") zero-exp)
   (expression ("null?" "(" expression ")") null-exp)
   (expression ("number?" "(" expression ")") number-exp)
   (expression ("car" "(" expression ")") car-exp)
   (expression ("cdr" "(" expression ")") cdr-exp)
   (expression ("add1" "(" expression ")") add1-exp)
   (expression ("sub1" "(" expression ")") sub1-exp)
   (expression ("cons" "(" expression "," expression ")") cons-exp)
   (expression ("equal?" "(" expression "," expression ")") equal-exp)
   (expression ("less?" "(" expression "," expression ")") less-exp)
   (expression ("greater?" "(" expression "," expression ")") greater-exp)
   (expression ("list" "(" (separated-list expression ",") ")") list-exp)
   (expression ("if" expression "then" expression "else" expression) if-exp)
   (expression ("let" (arbno identifier "=" expression) "in" expression) let-exp)
   (expression ("let2" identifier "=" expression identifier "=" expression "in" expression) let2-exp)
   (expression ("let3" identifier "=" expression identifier "=" expression identifier "=" expression "in" expression) let3-exp)
   (expression ("proc" "(" (separated-list identifier ",") ")" expression) proc-exp)
   (expression ("(" expression (arbno expression) ")") call-exp)
   (expression ("letrec" (arbno identifier "(" (separated-list identifier ",") ")" "=" expression) "in" expression) letrec-exp)
   (expression ("begin" expression (arbno ";" expression) "end") begin-exp)
   (expression ("set" identifier "=" expression) set-exp)
   (expression ("newref" "(" expression ")") newref-exp)
   (expression ("deref" "(" expression ")") deref-exp)
   (expression ("setref" "(" expression "," expression ")") setref-exp)
   (expression ("print" "(" expression ")") print-exp)
   (expression ("try" expression "catch" "(" (separated-list identifier ",") ")" expression) try-exp)
   (expression ("raise" expression) raise-exp)
   (expression ("letcc" identifier "in" expression) letcc-exp)
   (expression ("throw" expression "to" expression) throw-exp)
   (expression ("spawn" "(" expression ")") spawn-exp)
   (expression ("yield" "(" ")") yield-exp)
   (expression ("mutex" "(" ")") mutex-exp)
   (expression ("wait" "(" expression ")") wait-exp)
   (expression ("signal" "(" expression ")") signal-exp)
   (expression ("kill" "(" expression ")") kill-exp)
   (expression ("send" "(" expression "," expression ")") send-exp)
   (expression ("receive" "(" ")") receive-exp)
   (expression ("self" "(" ")") self-exp)
   (expression ("parent" "(" ")") parent-exp)))
(sllgen:make-define-datatypes lexical grammar)
(define scan&parse (sllgen:make-string-parser lexical grammar))
(define (parse text)
 (cases program (scan&parse text) (a-program (e) (ast e))))
(define (ast exp)
 (cases expression exp
  (const-exp (n) `(num ,n)) (var-exp (x) `(var ,x)) (empty-exp () '(list))
  (diff-exp (a b) `(prim - ,(ast a) ,(ast b)))
  (times-exp (a b) `(prim * ,(ast a) ,(ast b)))
  (divide-exp (a b) `(prim / ,(ast a) ,(ast b)))
  (sum-exp (es) `(prim + ,@(map ast es)))
  (zero-exp (e) `(prim zero? ,(ast e))) (null-exp (e) `(prim null? ,(ast e)))
  (number-exp (e) `(prim number? ,(ast e))) (car-exp (e) `(prim car ,(ast e)))
  (cdr-exp (e) `(prim cdr ,(ast e))) (add1-exp (e) `(prim add1 ,(ast e)))
  (sub1-exp (e) `(prim sub1 ,(ast e))) (cons-exp (a b) `(prim cons ,(ast a) ,(ast b)))
  (equal-exp (a b) `(prim equal? ,(ast a) ,(ast b)))
  (less-exp (a b) `(prim less? ,(ast a) ,(ast b)))
  (greater-exp (a b) `(prim greater? ,(ast a) ,(ast b)))
  (list-exp (es) `(list ,@(map ast es)))
  (if-exp (t a b) `(if ,(ast t) ,(ast a) ,(ast b)))
  (let-exp (xs es b) `(let ,xs ,(map ast es) ,(ast b)))
  (let2-exp (x e y f b) `(let (,x ,y) (,(ast e) ,(ast f)) ,(ast b)))
  (let3-exp (x e y f z g b) `(let (,x ,y ,z) (,(ast e) ,(ast f) ,(ast g)) ,(ast b)))
  (proc-exp (xs b) `(proc ,xs ,(ast b)))
  (call-exp (f es) `(call ,(ast f) ,(map ast es)))
  (letrec-exp (ns pss bs b) `(letrec ,ns ,pss ,(map ast bs) ,(ast b)))
  (begin-exp (e es) `(begin ,@(map ast (cons e es))))
  (set-exp (x e) `(set ,x ,(ast e)))
  (newref-exp (e) `(newref ,(ast e))) (deref-exp (e) `(deref ,(ast e)))
  (setref-exp (a b) `(setref ,(ast a) ,(ast b)))
  (print-exp (e) `(print ,(ast e)))
  (try-exp (e xs h) `(try ,(ast e) ,xs ,(ast h)))
  (raise-exp (e) `(raise ,(ast e)))
  (letcc-exp (x e) `(letcc ,x ,(ast e)))
  (throw-exp (a b) `(throw ,(ast a) ,(ast b)))
  (spawn-exp (e) `(spawn ,(ast e))) (yield-exp () '(yield))
  (mutex-exp () '(mutex)) (wait-exp (e) `(wait ,(ast e)))
  (signal-exp (e) `(signal ,(ast e))) (kill-exp (e) `(kill ,(ast e)))
  (send-exp (a b) `(send ,(ast a) ,(ast b))) (receive-exp () '(receive))
  (self-exp () '(self)) (parent-exp () '(parent))))
(define (unique! xs)
 (unless (= (length xs) (length (remove-duplicates xs))) (error 'bindings "duplicate identifiers")))
(define (arity! xs vs)
 (unless (= (length xs) (length vs)) (error 'arity "wrong number of arguments")))
(define (truth v [numeric? #f])
 (cond [(boolean? v) v] [(and numeric? (number? v)) (not (zero? v))]
       [else (error 'if "boolean required")]))
(define (primitive op vs)
 (define (numbers!) (unless (andmap number? vs) (error op "numbers required")))
 (when (memq op '(- * / + zero? add1 sub1 less? greater?)) (numbers!))
 (case op
  [(-) (apply - vs)] [(*) (apply * vs)] [(+) (apply + vs)]
  [(/) (if (zero? (cadr vs)) (error 'division "zero divisor") (quotient (car vs) (cadr vs)))]
  [(zero?) (zero? (car vs))] [(add1) (add1 (car vs))] [(sub1) (sub1 (car vs))]
  [(less?) (< (car vs) (cadr vs))] [(greater?) (> (car vs) (cadr vs))]
  [(number?) (number? (car vs))] [(equal?) (equal? (car vs) (cadr vs))]
  [(null?) (unless (list? (car vs)) (error 'null? "list required")) (null? (car vs))]
  [(car) (car (car vs))] [(cdr) (cdr (car vs))]
  [(cons) (unless (list? (cadr vs)) (error 'cons "list required")) (cons (car vs) (cadr vs))]
  [else (error 'primitive "unknown operation ~a" op)]))

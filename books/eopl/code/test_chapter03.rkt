#lang racket
(require rackunit rackunit/text-ui json
         (prefix-in s: "chapter03.rkt")
         (prefix-in l: "chapter03_lexical.rkt")
         (prefix-in v: "chapter03_variants.rkt"))
(define assertions 0)
(define (same got want) (set! assertions (add1 assertions)) (check-equal? got want))
(define (fails thunk) (set! assertions (add1 assertions)) (check-exn exn:fail? thunk))
(define (N text) (s:datum (s:run text)))
(define (L text #:layout [layout 'flat] #:trim [trim? #f] #:optimize [level 0])
  (s:datum (l:run/nameless text #:layout layout #:trim trim? #:optimize level)))
(define samples
  (list (cons "-(-(x,3),-(v,i))" 3)
        (cons "if zero?(-(33,11)) then -(22,2) else -(22,4)" 18)
        (cons "let z = 5 in let x = 3 in let y = -(x,1) in let x = 4 in -(z,-(x,y))" 3)
        (cons "let x = 7 in let y = 2 in let y = let x = -(x,1) in -(x,y) in -(-(x,8),y)" -5)
        (cons s:closure-example -100) (cons s:double-example 12)
        (cons s:self-times-example 12) (cons s:fixed-point-example 12)
        (cons s:proc-factorial-example 120) (cons s:proc-mutual-example 1)))
(define tests
  (test-suite "EOPL chapter 3"
    (test-case "original examples and independent arithmetic results"
      (for ([p samples]) (same (N (car p)) (cdr p)))
      (same (s:expval->num (s:num-val 10)) 10)
      (fails (lambda () (s:expval->num (s:bool-val #t))))
      (same (N "if zero?(0) then 7 else missing") 7)
      (same (N "if zero?(1) then missing else 9") 9))
    (test-case "primitive extensions and nested lists"
      (same (N "minus(-(minus(5),9))") 14)
      (same (N "+(3,4)") 7) (same (N "*(6,7)") 42)
      (same (N "quotient(-7,3)") -2)
      (same (N "equal?(7,7)") #t) (same (N "greater?(3,7)") #f)
      (same (N "less?(-1,0)") #t)
      (same (N "let x = 4 in cons(x,cons(cons(-(x,1),emptylist),emptylist))") '(4 (3)))
      (same (N "let x = 4 in list(x,-(x,1),-(x,3))") '(4 3 1))
      (same (N "car(list(zero?(0),1))") #t)
      (same (N "cdr(list(1,list(2),3))") '((2) 3))
      (same (N "list()") '()) (same (N "null?(emptylist)") #t))
    (test-case "cond and boolean language variants"
      (same (N "cond zero?(1) ==> missing zero?(0) ==> 8 end") 8)
      (same (s:datum (s:run "if 0 then 7 else 9" #:integers #t)) 9)
      (same (s:datum (s:run "if -2 then 7 else 9" #:integers #t)) 7)
      (same (s:datum (s:run "less?(3,4)" #:integers #t)) 1)
      (same (v:run/bool "let x = 7 in if less?(x,8) then -(x,1) else 0") 6)
      (fails (lambda () (v:run/bool "zero?(0)")))
      (fails (lambda () (v:run/bool "if 0 then 7 else 9")))
      (fails (lambda () (s:run "list(1)" #:integers #t))))
    (test-case "output and short circuit order"
      (define value #f)
      (define output (with-output-to-string (lambda () (set! value (N "-(print(3),print(4))")))))
      (same value 0) (same output "3\n4\n")
      (same (with-output-to-string (lambda () (s:run "if zero?(0) then print(7) else print(8)"))) "7\n")
      (same (with-output-to-string (lambda () (s:run "let f = traceproc (x) -(x,1) in (f (f 3))")))
            "enter (3)\nexit 2\nenter (2)\nexit 1\n"))
    (test-case "parallel bindings, sequential bindings and unpack"
      (same (N "let x = 30 in let x = -(x,1) y = -(x,2) in -(x,y)") 1)
      (same (N "let x = 30 in let* x = -(x,1) y = -(x,2) in -(x,y)") 2)
      (same (N "let in 7") 7)
      (same (N "let* x = 1 x = -(x,-1) in x") 2)
      (same (N "let u = 7 in unpack x y = cons(u,cons(3,emptylist)) in -(x,y)") 4)
      (same (N "unpack = emptylist in 7") 7)
      ;; Figure 3.14 is Scheme source used for contour analysis, run as Scheme.
      (same (((lambda (x y)
                (let ([z (+ x y)])
                  (lambda (x z)
                    (let ([x (let ([x (+ x y z)] [y 11]) (+ x y z))])
                      (+ x y z))))) 3 4) 5 6) 42))
    (test-case "named procedures, currying, arity and uniform front end"
      (same (N "letproc f(x) = -(x,1) in (f 9)") 8)
      (same (s:datum (v:run/letproc "letproc f(x) = -(x,1) in (f 9)")) 8)
      (fails (lambda () (v:run/letproc "proc (x) x")))
      (fails (lambda () (v:run/letproc "if zero?(0) then 1 else proc (x) x")))
      (same (N "let f = proc (x) proc (y) -(x,-(0,y)) in ((f 3) 4)") 7)
      (same (N "let f = proc (x,y) -(x,y) in (f 7 3)") 4)
      (same (N "(proc () 42)") 42)
      (same (s:datum (v:run/uniform "(let ((f (proc (x) (- x 1)))) (+ (f 9) 2))")) 10)
      (same (s:datum (v:run/uniform "(let ((+ (proc (x y) (- x y)))) (+ 9 2))")) 7)
      (fails (lambda () (v:run/uniform "1 2")))
      (fails (lambda () (v:run/uniform "#reader bad"))))
    (test-case "dynamic binding and alpha-renaming counterexample in both representations"
      (define text "let a = 3 in let p = proc (x) -(x,a) a = 5 in -(a,(p 2))")
      (same (N text) 6)
      (for ([repr '(data host)])
        (same (s:datum (s:run text #:scope 'dynamic #:procedures repr)) 8)
        (same (s:datum (s:run s:dynamic-factorial-example #:procedures repr)) 25)
        (same (s:datum (s:run s:dynamic-factorial-example #:scope 'dynamic #:procedures repr)) 120))
      (define original "let a = 3 in let p = proc (z) a in let f = proc (x) (p 0) in let a = 5 in (f 2)")
      (define renamed (string-replace original "proc (x)" "proc (a)"))
      (same (s:datum (s:run original #:scope 'dynamic)) 5)
      (same (s:datum (s:run renamed #:scope 'dynamic)) 2)
      (same (N original) 3) (same (N renamed) 3))
    (test-case "recursion, mutual recursion and all representations"
      (for* ([env '(data host)] [repr '(data host)] [rec '(fresh cached)] [n (in-range 10)])
        (same (s:datum (s:run (format "letrec double(x) = if zero?(x) then 0 else -((double -(x,1)),-2) in (double ~a)" n)
                             #:environment env #:procedures repr #:recursion rec)) (* 2 n))
        (same (s:datum (s:run (format "letrec even(x) = if zero?(x) then 1 else (odd -(x,1)) odd(x) = if zero?(x) then 0 else (even -(x,1)) in (odd ~a)" n)
                             #:environment env #:procedures repr #:recursion rec)) (modulo n 2)))
      (same (N "letrec sum(n,a) = if zero?(n) then a else (sum -(n,1) +(a,n)) in (sum 10 0)") 55)
      (define different-arities "letrec even(n) = if zero?(n) then 1 else (odd -(n,1) 0) odd(n,unused) = if zero?(n) then 0 else (even -(n,1)) in (odd 13 0)")
      (for* ([env '(data host)] [repr '(data host)] [rec '(fresh cached)])
        (same (s:datum (s:run different-arities #:environment env #:procedures repr #:recursion rec)) 1))
      (for ([layout '(flat rib)]) (same (L different-arities #:layout layout) 1))
      (define dynamic-mutual "let even = proc (x) if zero?(x) then 1 else (odd -(x,1)) in let odd = proc (x) if zero?(x) then 0 else (even -(x,1)) in (odd 13)")
      (for ([repr '(data host)])
        (same (s:datum (s:run dynamic-mutual #:scope 'dynamic #:procedures repr)) 1))
      (fails (lambda () (s:run dynamic-mutual))))
    (test-case "cached recursion really reuses the expressed closure"
      (for ([rec '(fresh cached)])
        (parameterize ([s:rec-mode rec] [s:env-mode 'data])
          (define env (s:extend-rec '(f) '((x)) (list (s:parse-expression "x")) (s:initial-environment)))
          (same (eq? (s:lookup env 'f) (s:lookup env 'f)) (eq? rec 'cached)))))
    (test-case "closure free variables and lifetime"
      (define escaped "let make = proc (x) proc (y) -(x,y) in let f = (make 12) in let x = 99 in (f 3)")
      (same (N escaped) 9) (same (s:datum (s:run escaped #:trim #t)) 9)
      (same (s:free-vars (s:parse-expression "proc (x) let y = x in -(y,z)")) '(z))
      (define p (s:expval->proc (s:run "let a = 3 in let unused = 99 in proc (x) -(x,a)" #:trim #t)))
      (same (s:binding-name (s:closure-saved p)) 'a)
      (same (s:binding-saved (s:closure-saved p)) '()))
    (test-case "exact lexical addresses, rejection and recursive references"
      (same (l:ir->datum (l:translation-of-program "let x = 37 in proc (y) let z = -(y,x) in -(x,y)"))
            '(%let (37) (%proc 1 #f (%let ((- (%lexref 0) (%lexref 1))) (- (%lexref 2) (%lexref 1))))))
      (fails (lambda () (l:translation-of-program "missing")))
      (fails (lambda () (l:nvalue-of (s:var-exp 'x) '())))
      (fails (lambda () (l:raw-reference '() 0 0)))
      (same (L s:double-example) 12))
    (test-case "cond, pack/unpack and rib frames"
      (for ([layout '(flat rib)])
        (same (L "cond zero?(1) ==> quotient(1,0) zero?(0) ==> 8 end" #:layout layout) 8)
        (same (L "unpack x y = pack(7,3) in -(x,y)" #:layout layout) 4)
        (same (L "let x = 30 in let x = -(x,1) y = -(x,2) in -(x,y)" #:layout layout) 1)
        (same (L "letrec sum(n,a) = if zero?(n) then a else (sum -(n,1) +(a,n)) in (sum 10 0)" #:layout layout) 55)
        (same (L "let f = proc () 7 in (f)" #:layout layout) 7)))
    (test-case "independent shadowing grid across named and nameless variants"
      (for* ([a '(-9 -1 0 3 12)] [b '(-7 0 2 5 20)] [c '(-3 0 1 4 9)])
        (define text (format "let a = ~a in let f = proc (x) -(a,x) in let a = ~a in (f ~a)" a b c))
        (define expected (- a c))
        (same (N text) expected)
        (same (s:datum (s:run text #:trim #t)) expected)
        (for ([layout '(flat rib)])
          (same (L text #:layout layout) expected)
          (same (L text #:layout layout #:trim #t) expected)
          (same (L text #:layout layout #:optimize 1) expected)
          (same (L text #:layout layout #:optimize 2) expected))))
    (test-case "known calls preserve escape, eager arguments, shadowing and effects"
      (for* ([layout '(flat rib)] [level '(0 1 2)])
        (same (L "let x = 3 in let f = proc (y) -(y,x) in let x = 100 in (f 13)" #:layout layout #:optimize level) 10)
        (same (L "let f = proc (x) proc (y) -(x,y) in let g = (f 8) in (g 3)" #:layout layout #:optimize level) 5)
        (same (L "let f = proc (x) -(x,1) in let g = f in (g 9)" #:layout layout #:optimize level) 8)
        (same (L "let f = proc (x) x in let f = proc (y) 99 in (f 1)" #:layout layout #:optimize level) 99)
        (define result #f)
        (same (with-output-to-string
                (lambda () (set! result (L "let f = proc (x) +(x,x) in (f print(7))" #:layout layout #:optimize level)))) "7\n")
        (same result 2)))
    (test-case "known-procedure counters distinguish the two requested optimizations"
      (define counts
        (for/list ([level '(0 1 2)])
          (define h (make-hash))
          (parameterize ([s:metrics h])
            (same (L "let x = 3 in let f = proc (y) -(y,x) in (f 13)" #:optimize level) 10)) h))
      (same (map (lambda (h) (hash-ref h 'closures 0)) counts) '(1 1 0))
      (same (map (lambda (h) (hash-ref h 'lexical-lookups 0)) counts) '(3 2 2)))
    (test-case "compact nameless closures preserve free-binding identity and nested capture"
      (for ([layout '(flat rib)])
        (same (L "let a = 3 in let unused = 99 in let f = proc (x) proc (y) -(-(x,y),a) in ((f 8) 2)" #:layout layout #:trim #t) 3)
        (same (L s:double-example #:layout layout #:trim #t) 12)
        (define p (s:expval->proc (l:run/nameless "let a = 3 in let unused = 99 in proc (x) -(x,a)" #:layout layout #:trim #t)))
        (same (apply + (map vector-length (l:nclosure-saved p))) 1)))
    (test-case "deterministic failure boundaries"
      (for ([text '("1 2" "-(zero?(0),1)" "if 0 then 1 else 2" "quotient(1,0)"
                    "car(emptylist)" "cdr(emptylist)" "cons(1,2)" "cond end"
                    "cond zero?(1) ==> 7 end" "unpack x = list(1,2) in x"
                    "let x = 1 x = 2 in x" "proc (x,x) x" "(1 2)"
                    "(proc (x) x)" "(proc () 1 2)" "letrec f(x) = x f(y) = y in 0")])
        (fails (lambda () (s:run text)))))))
(define failures (run-tests tests))
(write-json (hasheq 'status (if (zero? failures) "passed" "failed")
                    'groups 17 'assertions assertions 'failures failures 'racket (version)))
(newline) (exit (if (zero? failures) 0 1))

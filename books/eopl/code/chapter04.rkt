#lang racket
;; EOPL chapter 4: original companion interpreter; no host eval.
(require eopl)
(require "sllgen_guard.rkt")
(provide (all-defined-out))

;; BEGIN state-grammar
(define lexical-spec
  '((white-space (whitespace) skip)
    (comment ("%" (arbno (not #\newline))) skip)
    (identifier (letter (arbno (or letter digit "_" "-" "?"))) symbol)
    (number (digit (arbno digit)) number)
    (number ("-" digit (arbno digit)) number)))
(define grammar
  '((program (expression) a-program)
    (expression (number) const-exp) (expression (identifier) var-exp)
    (expression (unary-op "(" expression ")") unary-exp)
    (expression (binary-op "(" expression "," expression ")") binary-exp)
    (expression ("list" "(" (separated-list expression ",") ")") list-exp)
    (expression ("if" expression "then" expression "else" expression) if-exp)
    (expression ("let" (arbno identifier "=" expression) "in" expression) let-exp)
    (expression ("letmutable" identifier "=" expression "in" expression) letmutable-exp)
    (expression ("letref" identifier "=" expression "in" expression) letref-exp)
    (expression ("lazylet" (arbno identifier "=" expression) "in" expression) lazylet-exp)
    (expression (proc-kind "(" (separated-list identifier ",") ")" expression) proc-exp)
    (expression ("(" expression (arbno expression) ")") call-exp)
    (expression ("letrec" (arbno identifier "(" (separated-list identifier ",") ")" "=" expression) "in" expression) letrec-exp)
    (expression ("begin" expression (arbno ";" expression) "end") begin-exp)
    (expression ("set" identifier "=" expression) assign-exp)
    (expression ("setdynamic" identifier "=" expression "during" expression) dynamic-exp)
    (expression ("ref" identifier) ref-exp)
    (expression ("setref" "(" expression "," expression ")") setref-exp)
    (expression ("pair" "(" expression "," expression ")") pair-exp)
    (expression ("setleft" "(" expression "," expression ")") setleft-exp)
    (expression ("setright" "(" expression "," expression ")") setright-exp)
    (expression ("newarray" "(" expression "," expression ")") array-exp)
    (expression ("arrayref" "(" expression "," expression ")") arrayref-exp)
    (expression ("arrayset" "(" expression "," expression "," expression ")") arrayset-exp)
    (proc-kind ("proc") default-kind) (proc-kind ("procval") value-kind)
    (proc-kind ("procref") reference-kind)
    (unary-op ("zero?") zero-op) (unary-op ("not") not-op)
    (unary-op ("newref") newref-op) (unary-op ("deref") deref-op)
    (unary-op ("left") left-op) (unary-op ("right") right-op)
    (unary-op ("arraylength") length-op)
    (binary-op ("-") diff-op) (binary-op ("+") add-op)
    (binary-op ("*") times-op)))
(sllgen:make-define-datatypes lexical-spec grammar)
(define scan&parse (guard-sllgen (sllgen:make-string-parser lexical-spec grammar) lexical-spec grammar))
;; END state-grammar

;; BEGIN state-values
(struct num-val (n) #:transparent)
(struct bool-val (b) #:transparent)
(struct proc-val (p) #:transparent)
(struct ref-val (loc) #:transparent)
(struct pair-val (representation) #:transparent)
(struct array-val (base length) #:transparent)
(struct list-val (elements) #:transparent)
(struct sub-val (params body env) #:transparent)
(struct closure (params body env mode) #:transparent)
(struct thunk (expression env) #:transparent)
(struct immutable (value) #:transparent)
(define (expval? v)
  (or (num-val? v) (bool-val? v) (proc-val? v) (ref-val? v)
      (pair-val? v) (array-val? v) (list-val? v) (sub-val? v)))
(define (num v) (if (num-val? v) (num-val-n v) (error 'number "number required")))
(define (bool v) (if (bool-val? v) (bool-val-b v) (error 'boolean "boolean required")))
(define (reference v) (if (ref-val? v) (ref-val-loc v) (error 'reference "reference required")))
(define (procedure-value v) (if (proc-val? v) (proc-val-p v) (error 'call "procedure required")))
(define (datum v)
  (cond [(num-val? v) (num-val-n v)] [(bool-val? v) (bool-val-b v)]
        [(list-val? v) (map datum (list-val-elements v))]
        [(proc-val? v) '<procedure>] [(sub-val? v) '<subroutine>]
        [(ref-val? v) (list 'ref (ref-val-loc v))]
        [(pair-val? v) (list 'pair (pair-left-loc v) (pair-right-loc v))]
        [(array-val? v) (list 'array (array-val-base v) (array-val-length v))]
        [else (error 'datum "expressed value required")]))
;; END state-values

;; BEGIN store-interface
;; list is the textbook model; fixed is exercise 4.9; vector grows geometrically.
(struct store (cells size backend) #:mutable #:transparent)
(define current-store (make-parameter #f))
(define metrics (make-parameter #f))
(define event-log (make-parameter #f))
(define (bump! key) (when (metrics) (hash-update! (metrics) key add1 0)))
(define (event! kind loc value)
  (when (event-log)
    (set-box! (event-log) (cons (list kind loc value) (unbox (event-log))))))
(define (make-store [backend 'vector] [capacity 16])
  (unless (memq backend '(list fixed vector)) (error 'store "unknown backend"))
  (unless (exact-positive-integer? capacity) (error 'store "positive capacity required"))
  (store (if (eq? backend 'list) '() (make-vector capacity 'uninitialized)) 0 backend))
(define (valid-location! loc)
  (unless (and (exact-nonnegative-integer? loc) (< loc (store-size (current-store))))
    (error 'store "invalid location: ~s" loc)))
(define (newref! value)
  (define s (current-store)) (define next (store-size s))
  (cond [(eq? (store-backend s) 'list)
         (set-store-cells! s (append (store-cells s) (list value)))]
        [else
         (when (= next (vector-length (store-cells s)))
           (when (eq? (store-backend s) 'fixed) (error 'store "capacity exhausted"))
           (define grown (make-vector (* 2 (vector-length (store-cells s))) 'uninitialized))
           (vector-copy! grown 0 (store-cells s)) (set-store-cells! s grown))
         (vector-set! (store-cells s) next value)])
  (set-store-size! s (add1 next)) (bump! 'allocations) (event! 'allocate next value) next)
(define (deref! loc)
  (valid-location! loc) (define s (current-store)) (bump! 'reads)
  (define v (if (eq? (store-backend s) 'list) (list-ref (store-cells s) loc)
                (vector-ref (store-cells s) loc)))
  (when (eq? v 'uninitialized) (error 'store "uninitialized location: ~a" loc)) v)
(define (setref! loc value)
  (valid-location! loc) (define s (current-store))
  (if (eq? (store-backend s) 'list)
      (set-store-cells! s
        (let replace ([xs (store-cells s)] [i loc])
          (if (zero? i) (cons value (cdr xs)) (cons (car xs) (replace (cdr xs) (sub1 i))))))
      (vector-set! (store-cells s) loc value))
  (bump! 'writes) (event! 'write loc value) (void))
(define (store-snapshot)
  (define s (current-store))
  (if (eq? (store-backend s) 'list) (store-cells s)
      (vector->list (vector-copy (store-cells s) 0 (store-size s)))))
;; END store-interface

(define parameter-mode (make-parameter 'value))
(define rec-mode (make-parameter 'cached))
(define immutable-lets? (make-parameter #f))
(define optimize-thunks? (make-parameter #f))
(define pair-layout (make-parameter 'two))
(define fuel (make-parameter #f))
(define (tick!)
  (when (fuel)
    (when (zero? (unbox (fuel))) (error 'evaluation "fuel exhausted"))
    (set-box! (fuel) (sub1 (unbox (fuel))))))
(define (unique! names)
  (unless (= (length names) (length (remove-duplicates names))) (error 'bindings "duplicate names")))
(define (arity! names vals)
  (unless (= (length names) (length vals)) (error 'call "arity mismatch")))

;; BEGIN location-environments
(struct binding (name denotation saved) #:transparent)
(struct recursive-env (names paramss bodies saved) #:transparent)
(define (extend-many names denotations env)
  (unique! names) (arity! names denotations)
  (foldr (lambda (p rest) (binding (car p) (cdr p) rest)) env (map cons names denotations)))
(define (lookup env name)
  (cond [(null? env) (error 'lookup "unbound variable: ~a" name)]
        [(binding? env)
         (if (eq? name (binding-name env)) (binding-denotation env) (lookup (binding-saved env) name))]
        [(recursive-env? env)
         (define pos (index-of (recursive-env-names env) name))
         (if pos (newref! (make-closure (list-ref (recursive-env-paramss env) pos)
                                      (list-ref (recursive-env-bodies env) pos) env (parameter-mode)))
             (lookup (recursive-env-saved env) name))]
        [else (error 'lookup "invalid environment")]))
(define (make-closure params body env mode)
  (unique! params) (bump! 'closures) (proc-val (closure params body env mode)))
(define (initial-environment)
  (extend-many '(i v x) (map (lambda (n) (newref! (num-val n))) '(1 5 10)) '()))
(define (extend-rec names paramss bodies env)
  (unique! names) (for-each unique! paramss)
  (if (eq? (rec-mode) 'fresh)
      (recursive-env names paramss bodies env)
      (let* ([locs (map (lambda (_) (newref! 'uninitialized)) names)]
             [self (extend-many names locs env)])
        (for ([loc locs] [ps paramss] [body bodies])
          (setref! loc (make-closure ps body self (parameter-mode)))) self)))
(define (mutable-location env name)
  (define den (lookup env name))
  (when (immutable? den) (error 'assignment "immutable binding: ~a" name)) den)
;; END location-environments

;; BEGIN lazy-force
(define (force-location loc)
  (define value (deref! loc))
  (if (thunk? value)
      (let ([answer (begin (bump! 'forces)
                           (value-of (thunk-expression value) (thunk-env value)))])
        (when (eq? (parameter-mode) 'need) (setref! loc answer)) answer)
      value))
(define (read-variable env name)
  (define den (lookup env name))
  (if (immutable? den) (immutable-value den) (force-location den)))
(define (frozen-value exp env)
  (if (and (optimize-thunks?)
           (cases expression exp (const-exp (n) #t) (proc-exp (k ps b) #t) (else #f)))
      (value-of exp env)
      (begin (bump! 'thunks) (thunk exp env))))
;; END lazy-force

;; BEGIN aggregate-locations
(define (make-pair-value a b)
  (define left (newref! a)) (define right (newref! b))
  (pair-val (if (eq? (pair-layout) 'base) left (cons left right))))
(define (pair-left-loc p)
  (unless (pair-val? p) (error 'pair "pair required"))
  (define rep (pair-val-representation p)) (if (pair? rep) (car rep) rep))
(define (pair-right-loc p)
  (define rep (pair-val-representation p))
  (if (pair? rep) (cdr rep) (add1 (pair-left-loc p))))
(define (make-array-value n value)
  (unless (exact-nonnegative-integer? n) (error 'array "nonnegative length required"))
  (define base (store-size (current-store)))
  (for ([_ (in-range n)]) (newref! value)) (array-val base n))
(define (array-location a i)
  (unless (array-val? a) (error 'array "array required"))
  (unless (and (exact-nonnegative-integer? i) (< i (array-val-length a)))
    (error 'array "index out of bounds: ~s" i))
  (+ (array-val-base a) i))
;; END aggregate-locations

;; BEGIN parameter-locations
(define (operand-location exp env mode)
  (cond [(eq? mode 'value) (newref! (value-of exp env))]
        [(memq mode '(reference name need))
         (cases expression exp
           (var-exp (name) (mutable-location env name))
           (arrayref-exp (a i)
             (if (eq? mode 'reference)
                 (let* ([av (value-of a env)] [iv (num (value-of i env))]) (array-location av iv))
                 (newref! (frozen-value exp env))))
           (else (newref! (if (eq? mode 'reference) (value-of exp env) (frozen-value exp env)))))]
        [else (error 'parameter "unsupported parameter mode")]))
(define (apply-closure clos operands caller-env)
  (define params (closure-params clos)) (arity! params operands)
  (define mode (closure-mode clos))
  (cond [(eq? mode 'value-result)
         ;; Destinations are captured before entering the body. Copy-out is left to right.
         (define targets
           (for/list ([e operands])
             (cases expression e (var-exp (v) (mutable-location caller-env v))
               (else (error 'value-result "variable operand required")))))
         (define locals (map (lambda (l) (newref! (force-location l))) targets))
         (define answer (value-of (closure-body clos) (extend-many params locals (closure-env clos))))
         (define final-values (map force-location locals))
         (for ([target targets] [v final-values]) (setref! target v)) answer]
        [else
         (define locs (for/list ([e operands]) (operand-location e caller-env mode)))
         (value-of (closure-body clos) (extend-many params locs (closure-env clos)))]))
;; END parameter-locations

(define (kind-mode k)
  (cases proc-kind k (default-kind () (parameter-mode))
    (value-kind () 'value) (reference-kind () 'reference)))
(define (eval-unary op v)
  (cases unary-op op
    (zero-op () (bool-val (zero? (num v)))) (not-op () (bool-val (not (bool v))))
    (newref-op () (ref-val (newref! v))) (deref-op () (deref! (reference v)))
    (left-op () (deref! (pair-left-loc v))) (right-op () (deref! (pair-right-loc v)))
    (length-op () (unless (array-val? v) (error 'arraylength "array required"))
      (num-val (array-val-length v)))))
(define (eval-binary op a b)
  (num-val ((cases binary-op op (diff-op () -) (add-op () +) (times-op () *)) (num a) (num b))))

;; BEGIN implicit-evaluation
(define (value-of exp env)
  (tick!)
  (cases expression exp
    (const-exp (n) (num-val n)) (var-exp (v) (read-variable env v))
    (unary-exp (op e) (eval-unary op (value-of e env)))
    (binary-exp (op a b)
      (define av (value-of a env)) (define bv (value-of b env)) (eval-binary op av bv))
    (list-exp (es) (list-val (for/list ([e es]) (value-of e env))))
    (if-exp (t y n) (value-of (if (bool (value-of t env)) y n) env))
    (let-exp (names rhss body)
      (unique! names)
      (define vals (for/list ([e rhss]) (value-of e env)))
      (define ds (map (if (immutable-lets?) immutable newref!) vals))
      (value-of body (extend-many names ds env)))
    (letmutable-exp (name rhs body)
      (define v (value-of rhs env)) (value-of body (binding name (newref! v) env)))
    (letref-exp (name rhs body)
      (value-of body (binding name (operand-location rhs env 'reference) env)))
    (lazylet-exp (names rhss body)
      (unique! names)
      (define locs (for/list ([e rhss]) (newref! (frozen-value e env))))
      (value-of body (extend-many names locs env)))
    (proc-exp (kind ps body) (make-closure ps body env (kind-mode kind)))
    (call-exp (f args)
      (define clos (procedure-value (value-of f env))) (apply-closure clos args env))
    (letrec-exp (names paramss bodies body) (value-of body (extend-rec names paramss bodies env)))
    (begin-exp (first rest)
      (for/fold ([answer (value-of first env)]) ([e rest]) (value-of e env)))
    (assign-exp (name rhs)
      (define loc (mutable-location env name)) (define v (value-of rhs env))
      (setref! loc v) (num-val 27))
    (dynamic-exp (name rhs body)
      (define loc (mutable-location env name)) (define old (deref! loc))
      (define v (value-of rhs env))
      (dynamic-wind (lambda () (setref! loc v)) (lambda () (value-of body env))
                    (lambda () (setref! loc old))))
    (ref-exp (name) (ref-val (mutable-location env name)))
    (setref-exp (a b)
      (define loc (reference (value-of a env))) (define v (value-of b env))
      (setref! loc v) (num-val 23))
    (pair-exp (a b)
      (define av (value-of a env)) (define bv (value-of b env)) (make-pair-value av bv))
    (setleft-exp (a b)
      (define p (value-of a env)) (define v (value-of b env))
      (setref! (pair-left-loc p) v) (num-val 82))
    (setright-exp (a b)
      (define p (value-of a env)) (define v (value-of b env))
      (setref! (pair-right-loc p) v) (num-val 83))
    (array-exp (n e)
      (define size (num (value-of n env))) (define v (value-of e env)) (make-array-value size v))
    (arrayref-exp (a i)
      (define av (value-of a env)) (define iv (num (value-of i env))) (deref! (array-location av iv)))
    (arrayset-exp (a i e)
      (define av (value-of a env)) (define iv (num (value-of i env)))
      (define loc (array-location av iv)) (define v (value-of e env))
      (setref! loc v) (num-val 73))))
;; END implicit-evaluation

(struct execution (value store metrics events) #:transparent)
(define (run/details text #:mode [mode 'value] #:backend [backend 'vector]
                     #:capacity [capacity 16] #:rec [rec 'cached] #:immutable-let? [imm #f]
                     #:optimize-thunks? [opt #f] #:pairs [pairs 'two] #:fuel [limit 100000])
  (unless (exact-positive-integer? limit) (error 'fuel "positive exact integer required"))
  (unless (memq mode '(value reference value-result name need)) (error 'run "unknown mode"))
  (define counts (make-hash)) (define events (box '()))
  (parameterize ([current-store (make-store backend capacity)] [parameter-mode mode]
                 [rec-mode rec] [immutable-lets? imm] [optimize-thunks? opt]
                 [pair-layout pairs] [metrics counts] [event-log events] [fuel (box limit)])
    (define env (initial-environment))
    (define v (cases program (scan&parse text) (a-program (e) (value-of e env))))
    (execution v (store-snapshot) (hash-copy counts) (reverse (unbox events)))))
(define (run text #:mode [mode 'value]) (execution-value (run/details text #:mode mode)))

(module+ main
  (define assign-example "let p = proc(x) set x = 4 in let a = 3 in begin (p a); a end")
  (displayln (datum (run assign-example)))
  (displayln (datum (run assign-example #:mode 'reference)))
  (displayln (datum (run "let glo = pair(11,22) in let f = proc(loc) let d1 = setright(loc,left(loc)) in let d2 = setleft(glo,99) in -(left(loc),right(loc)) in (f glo)")))
  (define lazy-example "let c = 0 in let f = proc(x) -(x,x) in (f begin set c = -(c,-1); c end)")
  (displayln (datum (run lazy-example #:mode 'name)))
  (displayln (datum (run lazy-example #:mode 'need))))

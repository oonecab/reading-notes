#lang racket
(require "../code/chapter05.rkt")
(define (probe id value expected)
  (unless (equal? value expected) (error id "expected ~s, got ~s" expected value))
  (printf "~a ~s\n" id value))
(define (machine code regs) (execute code primitives regs))
(define (ev e [compiled? #f]) (answer (run-expression e #:compiled? compiled?)))
(probe 's5-1-1 (hash-ref (execution-registers (machine gcd-controller (hash 'a 206 'b 40))) 'a) 2)
(probe 's5-1-2 (answer (machine '(loop (test (op <) (reg val) (const 5)) (branch (label done))
  (assign val (op -) (reg val) (const 5)) (goto (label loop)) done) (hash 'val 17))) 2)
(probe 's5-1-3 (answer (machine (power-controller #t) (hash 'b 3 'n 4))) 81)
(probe 's5-1-4 (execution-depth (machine factorial-controller (hash 'n 4))) 6)
(probe 's5-1-5 (answer (machine (power-controller #f) (hash 'b 2 'n 5))) 32)
(probe 's5-2-1 (answer (machine iterative-factorial (hash 'n 5))) 120)
(probe 's5-2-2 (hash-ref (image-labels (assemble '((assign a (const 1)) (save a) (restore a) end))) 'end) 3)
(probe 's5-2-3 (answer (machine '((assign a (const 6)) (assign val (op *) (reg a) (const 7))) (hash))) 42)
(probe 's5-2-4 (execution-pushes (machine textbook-fib (hash 'n 4))) 16)
(define h (make-heap 4))
(define x (allocate h 1 2))
(define tail (allocate h x '()))
(define y (allocate h x tail))
(probe 's5-3-1 (heap-free h) 3)
(vector-set! (fields h y) 1 y)
(vector-set! (fields h y) 0 9)
(define-values (fresh roots) (collect h (list y y)))
(probe 's5-3-2 (heap-free fresh) 1)
(probe 's5-4-1 (ev '((lambda (x) (+ x 2)) 5)) 7)
(probe 's5-4-2 (- (execution-depth (run-expression (factorial-expression 8 #t))) (execution-depth (run-expression (factorial-expression 4 #t)))) 0)
(probe 's5-4-3 (ev '(begin (define x 2) (if #t (set! x 9) missing) x)) 9)
(probe 's5-4-4 (ev (factorial-expression 4)) 24)
(probe 's5-5-1 (ev 42 #t) 42)
(probe 's5-5-2 (ev '((lambda () 8)) #t) 8)
(probe 's5-5-3 (ev '(- 2 5) #t) -3)
(define a (make-instruction-sequence '() '(env) '((assign env (const 0)))))
(define b (make-instruction-sequence '(env) '() '((save env))))
(probe 's5-5-4 (- (length (statements (preserving '(env) a b))) 2) 2)
(probe 's5-5-5 (ev (factorial-expression 5) #t) 120)
(probe 's5-5-6 (find-variable 'c '((y z) (a b c d e) (x y))) '(1 2))
(probe 's5-5-7 (answer (run-expression (meta-expression (factorial-expression 5)) #:compiled? #t #:env (meta-env))) 120)

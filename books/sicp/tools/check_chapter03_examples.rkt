#lang racket
(require "../code/chapter03.rkt")
(define (probe id actual expected)
  (unless (equal? actual expected) (error 'readback "~a: got ~s, expected ~s" id actual expected))
  (printf "~a ~s\n" id actual))
(define a (make-account 100 'p))
(define b (make-account 100 'p))
(probe 's3-1-1 (list ((a 'p 'withdraw) 40) ((a 'p 'withdraw) 70) ((b 'p 'deposit) 0))
       '(60 "Insufficient funds" 100))
(define draws '(0 0 1/2 1/2))
(probe 's3-1-2 (estimate-integral (lambda (x y) (<= (+ (* x x) (* y y)) 1))
                                  -1 1 -1 1 2
                                  (lambda () (begin0 (car draws) (set! draws (cdr draws))))) 2)
(define alias a)
(probe 's3-1-3 (list ((alias 'p 'deposit) 5) ((a 'p 'deposit) 0) ((b 'p 'deposit) 0)) '(65 65 100))
(probe 's3-2-1 ((lambda (x) (* x x)) 5) 25)
(probe 's3-2-2 (let iter ([product 1] [n 6]) (if (zero? n) product (iter (* product n) (sub1 n)))) 720)
(define w (make-account 100 'p))
(probe 's3-2-3 (list ((w 'p 'withdraw) 50) ((b 'p 'deposit) 0)) '(50 100))
(define acc (make-account 50 'p))
(probe 's3-2-4 (list ((acc 'p 'deposit) 40) ((acc 'p 'withdraw) 60)) '(90 30))
(define chain (mcons 'a (mcons 'b (mcons 'c '()))))
(define reversed (reverse-chain! chain))
(probe 's3-3-1 (list (mcar reversed) (distinct-pairs reversed) (distinct-pairs chain)) '(c 3 1))
(define fifo (make-fifo))
(fifo 'insert! 'a) (fifo 'insert! 'b)
(probe 's3-3-2 (list (fifo 'delete!) (fifo 'delete!) (fifo 'empty?)) '(a b #t))
(define table (make-path-table equal?))
(table 'put! '(math add) 43) (table 'put! '(math sub) 45) (table 'put! '(math add) 44)
(probe 's3-3-3 (list (table 'get '(math add)) (table 'get '(math sub))) '(44 45))
(probe 's3-3-4 (schedule-and '((1 1) (1 0))) '(1 0))
(probe 's3-3-5 (list (+ 32 (* 9/5 25)) (* 5/9 (- 212 32))) '(77 100))
(probe 's3-4-1 (sort (set->list (transitions '(2 3))) <) '(100 1000 10000 100000 1000000))
(probe 's3-4-2 (map (lambda (ids) (sort ids <)) '((4 7) (7 4))) '((4 7) (4 7)))
(define forced '())
(define watched (smap (lambda (x) (set! forced (cons x forced)) x) (naturals 0)))
(void (prefix watched 6) (prefix watched 8))
(probe 's3-5-1 (reverse forced) '(0 1 2 3 4 5 6 7))
(define powers (scons 1 (smap + powers powers)))
(probe 's3-5-2 (prefix powers 4) '(1 2 4 8))
(define guesses (scons 1 (smap (lambda (g) (/ (+ g (/ 2 g)) 2)) guesses)))
(probe 's3-5-3 (stream-limit guesses 1/100) 577/408)
(define response ((RLC 1 1 1/5 1/10) 10 0))
(probe 's3-5-4 (prefix (smap list (car response) (cdr response)) 3) '((10 0) (10 1) (19/2 19/10)))
(probe 's3-5-5 (map (lambda (xs) (reverse (foldl (lambda (x totals) (cons (+ x (car totals)) totals))
                                                   '(100) xs))) '((-20 10) (10 -20)))
       '((100 80 90) (100 110 90)))

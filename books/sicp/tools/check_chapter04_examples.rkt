#lang racket
(require racket/stream racket/list "../code/chapter04.rkt")
(define (probe id value expected)
  (unless (equal? value expected) (error id "expected ~s, got ~s" expected value))
  (printf "~a ~s\n" id value))
(define (run e [m 'strict]) (actual e (fresh-environment) m))
(define (read-query goal var db)
  (for/list ([f (query goal db)]) (instantiate var f)))
(probe 's4-1-1 (run '((lambda (n) (+ n 2)) 5)) 7)
(probe 's4-1-2 (run '(let ((a 3) (b 5)) (* a b))) 15)
(probe 's4-1-3 (run '(let ((x 7)) (let ((f (lambda (a) (+ x a)))) (let ((x 100)) (f 3))))) 10)
(define env (fresh-environment))
(void (actual '(define n 4) env) (actual '(set! n (+ n 3)) env))
(probe 's4-1-4 (actual 'n env) 7)
(probe 's4-1-5 (run (run '(quote (* 5 5)))) 25)
(probe 's4-1-6 (run '(letrec ((odd-n (lambda (n) (if (= n 0) #f (even-n (- n 1)))))
                                (even-n (lambda (n) (if (= n 0) #t (odd-n (- n 1)))))) (odd-n 7))) #t)
(probe 's4-1-7 ((analyze-expression '((lambda (x) (* x x)) 9)) env) 81)
(probe 's4-2-1 (run '((lambda (a b) a) 7 (/ 1 0)) 'lazy) 7)
(probe 's4-2-2 (run '(begin (define n 0) (define (id x) (set! n (+ n 1)) x)
                             (define (sq x) (* x x)) (list (sq (id 10)) n)) 'lazy) '(100 1))
(probe 's4-2-3 (run '(begin (define (pc x y) (lambda (m) (m x y)))
                             ((pc (/ 1 0) 7) (lambda (x y) y))) 'lazy) 7)
(probe 's4-3-1 (amb-values '(let ((x (amb 2 3 4))) (require (> x 2)) x)) '(3 4))
(probe 's4-3-2 (amb-values '(let ((x (amb 1 2)) (y (amb 1 2))) (require (not (= x y))) (list x y)))
       '((1 2) (2 1)))
(probe 's4-3-3 (amb-values '(begin (define n 0) (let ((x (amb 1 2))) (set! n (+ n 1)) n))) '(1 1))
(define edges '((edge a b) (edge a d) (edge b c)))
(probe 's4-4-1 (read-query '(and (edge a ?m) (edge ?m ?last)) '?last edges) '(c))
(probe 's4-4-2 (read-query '(and (salary ?n) (lisp-value > ?n 4)) '?n '((salary 3) (salary 7))) '(7))
(probe 's4-4-3 (read-query '(and (edge a ?m) (not (edge ?m c))) '?m edges) '(d))
(probe 's4-4-4-1 (instantiate '(?x) (hash '?x '?y '?y 3)) '(3))
(probe 's4-4-4-2 (read-query '(or (red ?x) (blue ?x)) '?x '((red pen) (blue cup))) '(pen cup))
(probe 's4-4-4-3 (read-query '(pair ?x ?x) '?x '((pair 1 1) (pair 1 2))) '(1))
(probe 's4-4-4-4 (unify '?x '(a . ?x) (hash)) #f)
(probe 's4-4-4-5 (map (lambda (db) (read-query '(edge a ?x) '?x db))
                       '(((edge a b)) ((edge a d) (edge a b)))) '((b) (d b)))
(probe 's4-4-4-6 (for/list ([f (query '(or (r ?x) (b ?x)) '((r 1) (r 2) (b 3) (b 4)))]
                            [_ (in-range 2)]) (instantiate '?x f)) '(1 3))
(probe 's4-4-4-7 (instantiate '(?x red) (unify '?x 'red (hash))) '(red red))
(probe 's4-4-4-8 (map (lambda (f) (instantiate '?x f)) (list (unify '?x 3 (hash)) (unify '?x 5 (hash)))) '(3 5))

(module+ benchmark
(define exp '(begin (define (fact n) (if (= n 0) 1 (* n (fact (- n 1))))) (fact 10)))
(define n 5000)
(define (measure thunk)
  (collect-garbage)
  (define start (current-inexact-monotonic-milliseconds))
  (for ([i n]) (thunk))
  (- (current-inexact-monotonic-milliseconds) start))
(define compiled (analyze-expression exp))
(define timing-env (fresh-environment))
(unless (= (actual exp timing-env) (compiled timing-env) 3628800) (error "factorial"))
(printf "~a ~a ~a ~a\n" n (measure (lambda () (analyze-expression exp)))
        (measure (lambda () (compiled timing-env))) (measure (lambda () (actual exp timing-env)))))

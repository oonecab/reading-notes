#lang racket
(require rackunit rackunit/text-ui "chapter01.rkt")
(define (linear-fib n) (for/fold ([a 0] [b 1] #:result a) ([i (in-range n)]) (values b (+ a b))))
(define tests
  (test-suite
   "SICP chapter 1 independent properties and examples"
   (test-case "1.1--1.6 expression values, ties, signs, eager arguments"
     (check-equal? (/ (+ 5 4 (- 2 (- 3 (+ 6 4/5)))) (* 3 (- 6 2) (- 2 7))) -37/150)
     (for* ([a (in-range -3 4)] [b (in-range -3 4)] [c (in-range -3 4)])
       (check-equal? (two-largest-squares a b c) (apply + (map square (take (sort (list a b c) >) 2)))))
     (for* ([a '(-3 0 4)] [b '(-5 0 7)]) (check-equal? (a-plus-abs-b a b) (+ a (abs b))))
     (let ([evaluated 0])
       (check-equal? (new-if #t (begin (set! evaluated (add1 evaluated)) 5)
                               (begin (set! evaluated (add1 evaluated)) 0)) 5)
       (check-equal? evaluated 2)))
   (test-case "1.7--1.8 roots across scale and rejection"
     (check-true (> (sqrt-original 1e-12) 0.03))
     (check-exn exn:fail? (lambda () (sqrt-original 1e13)))
     (for ([x '(1e-200 1e-12 2 100 1e20 1e200)])
       (check-= (/ (sqrt-relative x) (sqrt x)) 1.0 1e-10))
     (for ([x '(-1e200 -27 -1e-200 0 8 1e200)])
       (check-= (cube-root x) (* (if (negative? x) -1 1) (expt (abs x) 1/3)) (* 1e-10 (max 1e-100 (expt (abs x) 1/3)))))
     (check-equal? (sqrt-relative 0) 0.0)
     (check-exn exn:fail? (lambda () (sqrt-relative -1)))
     (check-exn exn:fail? (lambda () (sqrt-relative +inf.0))))
   (test-case "1.9--1.15 independent finite cases"
     (check-equal? (add-rec 4 5) 9) (check-equal? (add-iter 4 5) 9)
     (check-equal? (list (A 1 10) (A 2 4) (A 3 3)) '(1024 65536 65536))
     (for ([n (in-range -3 15)]) (check-equal? (f-iter n) (f-rec n)))
     (for ([r (in-range 12)])
       (check-equal? (for/sum ([c (in-range (add1 r))]) (pascal r c)) (expt 2 r)))
     (check-equal? (cc 11 5) 4) (check-equal? (cc 100 5) 292)
     (let-values ([(s count) (sine-count 12.15)]) (check-equal? count 5) (check-= s (sin 12.15) 0.01)))
   (test-case "1.16--1.21 exact integer properties"
     (for* ([a (in-range -8 9)] [b (in-range 0 25)])
       (check-equal? (fast-expt a b) (expt a b))
       (check-equal? (multiply-rec a b) (* a b)))
     (for* ([a (in-range -15 16)] [b (in-range -15 16)]) (check-equal? (multiply-iter a b) (* a b)))
     (for ([n (in-range 1001)]) (check-equal? (fib-fast n) (linear-fib n)))
     (let-values ([(g count) (gcd-count 206 40)]) (check-equal? g 2) (check-equal? count 4))
     (check-equal? (map smallest-divisor '(199 1999 19999)) '(199 1999 7)))
   (test-case "1.22--1.28 primes, Carmichael and MR witnesses"
     (check-equal? (map search-for-primes '(1000 10000 100000 1000000))
                   '((1009 1013 1019) (10007 10009 10037) (100003 100019 100043) (1000003 1000033 1000037)))
     (check-equal? (search-for-primes 1000 3 1010) '(1009))
     (let ([port (open-output-string)])
       (parameterize ([current-output-port port]) (check-true (timed-prime-test 199)))
       (check-true (regexp-match? #rx"199 \\*\\*\\* [0-9]+" (get-output-string port))))
     (for ([n (in-range 2 300)])
       (define trial (for/and ([d (in-range 2 n)]) (not (zero? (remainder n d)))))
       (check-equal? (prime? n) trial)
       (check-equal? (prime? n next-odd) trial)
       (check-equal? (for/and ([a (in-range 1 n)]) (mr-base? n a)) trial))
     (for ([n '(561 1105 1729 2465 2821 6601)])
       (check-false (prime? n)) (check-true (fermat-all? n))
       (check-false (miller-rabin? n '(2 3 5 7 11))))
     (check-equal? (mr-expmod 2 8 9) 4) (check-false (mr-base? 9 2))
     (check-true (mr-base? 2047 2)) (check-false (mr-base? 2047 3))
     (check-true (miller-rabin/random? 2047 1 (lambda (bound) 1)))
     (check-false (miller-rabin/random? 2047 1 (lambda (bound) 2)))
     (check-false (miller-rabin/random? 9 1 (lambda (bound) 1)))
     (check-true (miller-rabin/random? 199 20 (lambda (bound) (sub1 bound))))
     (check-true (miller-rabin/random? 2 1 (lambda (bound) (error "must not sample for 2"))))
     (check-exn exn:fail? (lambda () (miller-rabin/random? 199 0)))
     (for* ([base '(2 3 7)] [e (in-range 1 100)] [m '(11 17 23)])
       (check-equal? (expmod base e m) (modulo (expt base e) m))
       (check-equal? (expmod-duplicated base e m) (expmod base e m))))
   (test-case "1.29--1.33 exact integration and fold order"
     (for ([n '(2 100 1000)]) (check-equal? (simpson cube 0 1 n) 1/4))
     (check-= (midpoint-integral cube 0 1 0.01) 0.2499875 1e-12)
     (check-= (midpoint-integral cube 0 1 0.001) 0.249999875 1e-12)
     (check-equal? (simpson cube 1 0 100) -1/4)
     (for ([n '(0 3 2.5)]) (check-exn exn:fail? (lambda () (simpson cube 0 1 n))))
     (for ([n (in-range 10)])
       (check-equal? (sum-iter square 1 add1 n) (/ (* n (add1 n) (+ (* 2 n) 1)) 6))
       (check-equal? (product-rec values 1 add1 n) (factorial n)))
     (check-equal? (accumulate-rec list 'z values 1 add1 3) '(1 (2 (3 z))))
     (check-equal? (accumulate-iter list 'z values 1 add1 3) '(((z 1) 2) 3))
     (check-exn exn:fail? (lambda () (sum-iter values 1 values 2)))
     (check-equal? (prime-square-sum 2 10) 87) (check-equal? (coprime-product 10) 189)
     (check-equal? (coprime-product 1) 1))
   (test-case "1.34--1.39 invalid application, fixed points, fractions"
     (let ([f (lambda (g) (g 2))]) (check-exn exn:fail:contract? (lambda () (f f))))
     (check-= (fixed-point (lambda (x) (+ 1 (/ 1 x))) 1.0) (/ (+ 1 (sqrt 5)) 2) 1e-5)
     (check-= (half-interval sin 2.0 4.0) pi 0.001)
     (check-exn exn:fail? (lambda () (half-interval square -1 1)))
     (check-exn exn:fail? (lambda () (fixed-point/trace (lambda (x) (- x)) 1.0 1e-5 10)))
     (for ([k (in-range 0 31)]) (check-equal? (cont-frac-rec (lambda (i) 1) (lambda (i) 1) k)
                                            (cont-frac-iter (lambda (i) 1) (lambda (i) 1) k)))
     (let* ([target (/ 2 (+ 1 (sqrt 5)))]
            [first-depth (lambda (tolerance)
                           (for/first ([k (in-range 1 31)]
                                       #:when (< (abs (- (cont-frac-iter (lambda (i) 1) (lambda (i) 1) k) target)) tolerance)) k))])
       (check-equal? (first-depth 0.00005) 11)
       (check-equal? (first-depth 0.0001) 10))
     (check-= (e-approx 20) (exp 1) 1e-12) (check-= (tan-cf 1.0 20) (tan 1.0) 1e-12))
   (test-case "1.40--1.46 higher order meaning and numerical boundaries"
     (let* ([g (cubic 0 -2 -3)] [r (newtons-method g 1.0)]) (check-= (g r) 0 1e-8))
     (check-exn exn:fail? (lambda () (newtons-method (lambda (x) 1) 1)))
     (check-equal? (((double (double double)) inc) 5) 21)
     (check-equal? ((compose square inc) 6) 49)
     (check-equal? ((repeated square 2) 5) 625) (check-equal? ((repeated inc 0) 5) 5)
     (check-equal? ((n-fold-smooth square 4 1/10) 2) (+ 4 (* 4 2/300)))
     (for ([n (in-range 2 21)]) (check-= (nth-root 17 n) (expt 17 (/ 1 n)) 1e-9))
     (check-= (nth-root -8 3) -2 1e-10) (check-equal? (nth-root 0 5) 0.0)
     (check-exn exn:fail? (lambda () (nth-root -8 2)))
     (check-exn exn:fail? (lambda () (nth-root 2 0)))
     (check-= (sqrt-via-improve 1e-100) 1e-50 1e-60)
     (let ([x (fixed-point-via-improve cos 1.0)]) (check-true (< (abs (- x (cos x))) 1e-5))) )))
(module+ main (exit (run-tests tests)))

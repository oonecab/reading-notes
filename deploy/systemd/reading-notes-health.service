[Unit]
Description=Check Reading Notes current release over local HTTPS
After=nginx.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -I /usr/local/lib/reading-notes/deploy/scripts/healthcheck.py --monitor
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal
